# Run from the repository root with lmctl test.lms or lmscript test.lms.
fn step(command) {
  result = system(command, {timeoutMs:600000});
  print(result.stdout); print(result.stderr);
  assert(result.code == 0, "failed: " + json_stringify(command));
}
mkdir("build");
set_env("CGO_ENABLED", "0");
step(["go", "mod", "verify"]);
step(["python3", "tests/providers/codex/generate.py", "--check"]);
step(["bash", "scripts/compile-examples.sh"]);
step(["bash", "scripts/compile-stdio.sh"]);
step(["bash", "scripts/compile-streamjson.sh"]);
step(["bash", "tests/acp-profiles/compile.sh"]);
step(["node", "scripts/fixtures.mjs"]);
step(["bash", "scripts/compile-fixtures.sh"]);
step(["go", "test", "./..."]);
step(["python3", "tests/scenario/controls.py"]);
step(["python3", "tests/stdio/controls.py"]);
ext = ""; if (env("RUNNER_OS") == "Windows") { ext = ".exe"; }
version = env("SAMPLE_VERSION") || "0.1.0";
step(["go", "build", "-trimpath", "-ldflags=-s -w -X main.version=" + version, "-o", "build/lmmock" + ext, "./cmd/lmmock"]);
step(["go", "build", "-o", "build/codex-fixture" + ext, "./tests/providers/codex/fakecli"]);
step(["node", "tests/integration.mjs", "build/lmmock" + ext]);
step(["node", "tests/stream-tls/run.mjs", "build/lmmock" + ext]);
step(["python3", "tests/stream-tls/controls.py"]);
step(["node", "tests/stdio/process.mjs", "build/lmmock" + ext]);
step(["node", "tests/acp-profiles/controls.mjs"]);
step(["node", "tests/acp-profiles/cancel-client.mjs"]);

step(["build/lmmock" + ext, "exec", "--lmcode", "build/llm.dslb", "--config", "examples/llm-config.json", "--", path_join(Directory, "build/lmmock" + ext), "check", "--suite", "examples/llm-client.json"]);
step(["go", "build", "-o", "build/codex-fixture" + ext, "./tests/providers/codex/fakecli"]);
step(["node", "tests/acp-profiles/run.mjs"]);
step(["node", "tests/providers/codex/manifest-run.mjs"]);
step(["node", "tests/provider-fixtures/contract.test.mjs", "build/lmmock" + ext]);
step(["node", "tests/providers/codex/run.mjs"]);
step(["python3", "tests/providers/codex/controls.py"]);
step(["build/lmmock" + ext, "exec", "--lmcode", "build/copilot.dslb", "--config", "examples/copilot-config.json", "--", path_join(Directory, "build/lmmock" + ext), "check", "--suite", "examples/copilot-client.json"]);
step(["node", "tests/protocols.mjs", "build/lmmock" + ext]);
step(["node", "tests/request-count.mjs", "build/lmmock" + ext]);

# Real Vercel AI SDK client; install tests/vercel dependencies with npm ci first.
step(["node", "tests/vercel/run.mjs", "build/lmmock" + ext]);

step(["node", "tests/runtime-json.mjs", "build/lmmock" + ext]);

# OpenAI JSON and Responses event SSE use the existing HTTP transport.
step(["bash", "tests/openai/compile.sh"]);
step(["node", "tests/openai/run.mjs", "build/lmmock" + ext]);
step(["node", "tests/openai/controls.mjs", "build/lmmock" + ext]);
step(["node", "tests/provider-fixtures/run.mjs", "fixtures/providers/openai-chat-native.json", "build/lmmock" + ext]);
step(["node", "tests/provider-fixtures/run.mjs", "fixtures/providers/openai-responses-native.json", "build/lmmock" + ext]);

# Provider fixture contract runner

# Anthropic Messages, Gemini content, Ollama NDJSON and Miniplayer compatibility
step(["node", "tests/provider-compat/lmscript-command.test.mjs"]);
step(["node", "tests/provider-compat/run.mjs", "build/lmmock" + ext]);
# Stream-json policies run as native fake CLIs, not HTTP handlers.
step(["node", "tests/streamjson/process.mjs", "build/lmmock" + ext]);
step(["node", "tests/streamjson/run.mjs", "build/lmmock" + ext]);
step(["node", "tests/streamjson/controls.mjs", "build/lmmock" + ext]);
