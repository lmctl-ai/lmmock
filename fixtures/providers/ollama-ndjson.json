{
  "schema_version": 1,
  "id": "ollama-ndjson",
  "dialect": {
    "id": "ollama-ndjson",
    "version": "0.5.0",
    "transport": "ndjson"
  },
  "source": {
    "kind": "public-spec",
    "reference": "https://github.com/ollama/ollama/blob/main/docs/api.md",
    "version": "0.5.0",
    "retrieved": "2026-10-31",
    "note": "Ollama NDJSON line-delimited chat/generate and tag discovery"
  },
  "server": {
    "kind": "http",
    "handler": "fixtures/ollama/handler.lms",
    "config": "fixtures/ollama/wire.json",
    "url_env": "LMMOCK_URL"
  },
  "models": [
    {
      "id": "fixture-ollama",
      "family": "llama3.2",
      "capabilities": [
        "chat",
        "stream",
        "tools"
      ]
    },
    {
      "id": "llama3.2",
      "family": "llama3.2",
      "capabilities": [
        "chat",
        "stream"
      ]
    },
    {
      "id": "llama3.1",
      "family": "llama3.1",
      "capabilities": [
        "chat",
        "stream"
      ]
    },
    {
      "id": "qwen2.5",
      "family": "qwen2.5",
      "capabilities": [
        "chat",
        "stream"
      ]
    }
  ],
  "routes": [
    {
      "id": "chat",
      "method": "POST",
      "path": "/api/chat",
      "annotation": "ollama_chat",
      "sam": "Handler",
      "content_types": [
        "application/json",
        "application/x-ndjson"
      ]
    },
    {
      "id": "generate",
      "method": "POST",
      "path": "/api/generate",
      "annotation": "ollama_chat",
      "sam": "Handler",
      "content_types": [
        "application/json",
        "application/x-ndjson"
      ]
    },
    {
      "id": "tags",
      "method": "GET",
      "path": "/api/tags",
      "annotation": "ollama_tags",
      "sam": "Handler",
      "content_types": [
        "application/json"
      ]
    },
    {
      "id": "version",
      "method": "GET",
      "path": "/api/version",
      "annotation": "ollama_version",
      "sam": "Handler",
      "content_types": [
        "application/json"
      ]
    }
  ],
  "cases": [
    {
      "id": "ollama-keyless-success",
      "kind": "usage",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": {
          "model": "fixture-ollama",
          "messages": [
            {
              "role": "user",
              "content": "ping"
            }
          ],
          "stream": false
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "model": "fixture-ollama",
          "message.content": "pong",
          "done": true,
          "prompt_eval_count": 10,
          "eval_count": 2
        }
      }
    },
    {
      "id": "ollama-stream-ndjson",
      "kind": "stream",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": {
          "model": "fixture-ollama",
          "messages": [
            {
              "role": "user",
              "content": "ping"
            }
          ],
          "stream": true
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "application/x-ndjson"
        },
        "events": [
          "\"done\":false",
          "\"done\":true"
        ],
        "stream": {
          "dialect": "ollama",
          "text": "pong",
          "input_tokens": 10,
          "output_tokens": 2
        }
      }
    },
    {
      "id": "ollama-tool-call-json",
      "kind": "tool",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": {
          "model": "fixture-ollama",
          "messages": [
            { "role": "user", "content": "weather in Tokyo" }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "get_weather",
                "description": "Get weather for a city",
                "parameters": {
                  "type": "object",
                  "properties": { "city": { "type": "string" } },
                  "required": ["city"]
                }
              }
            }
          ],
          "stream": false
        }
      },
      "expect": {
        "status": 200,
        "json": { "message.role": "assistant", "message.content": "", "done": true },
        "tool_calls": [
          { "function": { "name": "get_weather", "arguments": { "city": "Tokyo" } } }
        ]
      }
    },
    {
      "id": "ollama-tool-call-ndjson",
      "kind": "stream",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": {
          "model": "fixture-ollama",
          "messages": [
            { "role": "user", "content": "weather in Tokyo" }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "get_weather",
                "description": "Get weather for a city",
                "parameters": {
                  "type": "object",
                  "properties": { "city": { "type": "string" } },
                  "required": ["city"]
                }
              }
            }
          ],
          "stream": true
        }
      },
      "expect": {
        "status": 200,
        "headers": { "content-type": "application/x-ndjson" },
        "stream": { "dialect": "ollama", "text": "", "input_tokens": 10, "output_tokens": 2 },
        "events": [
          "\"tool_calls\":[{\"function\":{\"name\":\"get_weather\",\"arguments\":{\"city\":\"Tokyo\"}}}]",
          "\"done\":true"
        ]
      }
    },
    {
      "id": "ollama-tool-result-history",
      "kind": "success",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": {
          "model": "fixture-ollama",
          "messages": [
            { "role": "user", "content": "weather in Tokyo" },
            {
              "role": "assistant",
              "content": "",
              "tool_calls": [
                { "function": { "name": "get_weather", "arguments": { "city": "Tokyo" } } }
              ]
            },
            { "role": "tool", "tool_name": "get_weather", "content": "11 degrees celsius" }
          ],
          "tools": [
            {
              "type": "function",
              "function": {
                "name": "get_weather",
                "description": "Get weather for a city",
                "parameters": {
                  "type": "object",
                  "properties": { "city": { "type": "string" } },
                  "required": ["city"]
                }
              }
            }
          ],
          "stream": false
        }
      },
      "expect": {
        "status": 200,
        "json": { "message.role": "assistant", "message.content": "Tool result: 11 degrees celsius", "done": true }
      }
    },
    {
      "id": "ollama-tags",
      "kind": "model",
      "request": { "kind": "http", "method": "GET", "path": "/api/tags" },
      "expect": {
        "status": 200,
        "json": { "models.0.name": "fixture-ollama", "models.0.model": "fixture-ollama" }
      }
    },
    {
      "id": "ollama-overloaded",
      "kind": "error",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": { "model": "overloaded", "messages": [{ "role": "user", "content": "ping" }], "stream": false }
      },
      "expect": { "status": 429, "body_contains": "rate limit exceeded" }
    },
    {
      "id": "ollama-server-error",
      "kind": "error",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": { "model": "server-error", "messages": [{ "role": "user", "content": "ping" }], "stream": false }
      },
      "expect": { "status": 500, "json": { "error": "server error" } }
    },
    {
      "id": "ollama-missing-model",
      "kind": "error",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": { "messages": [{ "role": "user", "content": "ping" }], "stream": false }
      },
      "expect": { "status": 400, "json": { "error": "model is required" } }
    },
    {
      "id": "ollama-unknown-model",
      "kind": "model",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/chat",
        "body": {
          "model": "unknown-model",
          "messages": [
            {
              "role": "user",
              "content": "ping"
            }
          ],
          "stream": false
        }
      },
      "expect": {
        "status": 404,
        "body_contains": "not found"
      },
      "faults": [
        "unknown-model"
      ]
    },
    {
      "id": "ollama-generate-json",
      "kind": "success",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/generate",
        "body": {
          "model": "fixture-ollama",
          "prompt": "ping",
          "stream": false
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "response": "pong",
          "done": true,
          "prompt_eval_count": 10,
          "eval_count": 2
        }
      }
    },
    {
      "id": "ollama-generate-stream",
      "kind": "stream",
      "request": {
        "kind": "http",
        "method": "POST",
        "path": "/api/generate",
        "body": {
          "model": "fixture-ollama",
          "prompt": "ping",
          "stream": true
        }
      },
      "expect": {
        "status": 200,
        "events": [
          "\"response\":\"pong\"",
          "\"done\":true"
        ],
        "stream": {
          "dialect": "ollama",
          "text": "pong",
          "input_tokens": 10,
          "output_tokens": 2
        }
      }
    }
  ],
  "faults": [
    {
      "id": "unknown-model",
      "surface": "http",
      "trigger": {
        "case_id": "ollama-unknown-model",
        "model": "unknown-model"
      },
      "description": "Unknown model returns 404 with model not found diagnostic"
    }
  ]
}
