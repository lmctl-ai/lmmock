{
  "schema_version": 1,
  "id": "acp-gemini",
  "dialect": {
    "id": "acp-gemini",
    "version": "1",
    "transport": "acp"
  },
  "source": {
    "kind": "synthetic",
    "reference": "https://agentclientprotocol.com/protocol/v1/prompt-turn",
    "version": "ACP v1; npm lmctl 0.2.448; mono 8e334dda",
    "retrieved": "2026-10-31",
    "note": "Synthetic model families and wire values. Gemini is profile-only: the published adapter is disabled. Usage metadata is not billing usage."
  },
  "server": {
    "kind": "stdio",
    "handler": "fixtures/acp/handler.lms",
    "config": "fixtures/acp/gemini-success.json",
    "binary": "lmmock"
  },
  "models": [
    {
      "id": "fixture-gemini-gemini",
      "family": "gemini",
      "capabilities": [
        "chat",
        "tools",
        "stream"
      ],
      "price_record": null
    },
    {
      "id": "fixture-gemini-gemma",
      "family": "gemma",
      "capabilities": [
        "chat",
        "tools",
        "stream"
      ],
      "price_record": null
    }
  ],
  "routes": [
    {
      "id": "initialize",
      "method": "RPC",
      "path": "/initialize",
      "annotation": "initialize",
      "sam": "RPCHandler"
    },
    {
      "id": "session-new",
      "method": "RPC",
      "path": "/session/new",
      "annotation": "open",
      "sam": "RPCHandler"
    },
    {
      "id": "session-load",
      "method": "RPC",
      "path": "/session/load",
      "annotation": "open",
      "sam": "RPCHandler"
    },
    {
      "id": "session-prompt",
      "method": "RPC",
      "path": "/session/prompt",
      "annotation": "prompt",
      "sam": "RPCHandler"
    },
    {
      "id": "session-cancel",
      "method": "RPC",
      "path": "/session/cancel",
      "annotation": "cancel",
      "sam": "RPCHandler"
    }
  ],
  "cases": [
    {
      "id": "gemini-success",
      "kind": "stream",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/acp-profiles/run-case.mjs",
          "gemini-success"
        ],
        "env": {
          "LMMOCK_ACP_SCENARIO": "fixtures/acp/gemini-success.json"
        }
      },
      "expect": {
        "exit_code": 0,
        "error_class": "unknown",
        "stdout_contains": "Standalone Gemini CLI support is disabled"
      }
    },
    {
      "id": "gemini-auth",
      "kind": "error",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/acp-profiles/run-case.mjs",
          "gemini-auth"
        ],
        "env": {
          "LMMOCK_ACP_SCENARIO": "fixtures/acp/gemini-auth.json"
        }
      },
      "expect": {
        "exit_code": 0,
        "error_class": "unknown",
        "stdout_contains": "Standalone Gemini CLI support is disabled"
      },
      "faults": [
        "auth-invalid"
      ]
    },
    {
      "id": "gemini-cancel",
      "kind": "stream",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/acp-profiles/run-case.mjs",
          "gemini-cancel"
        ],
        "env": {
          "LMMOCK_ACP_SCENARIO": "fixtures/acp/gemini-cancel.json"
        }
      },
      "expect": {
        "exit_code": 0,
        "json": {
          "events": [
            "agent_message_chunk",
            "cancelled",
            "end_turn"
          ]
        }
      }
    },
    {
      "id": "gemini-missing",
      "kind": "error",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/acp-profiles/run-case.mjs",
          "gemini-missing"
        ],
        "env": {
          "LMMOCK_ACP_SCENARIO": "fixtures/acp/gemini-missing.json"
        }
      },
      "expect": {
        "exit_code": 0,
        "error_class": "unknown",
        "stdout_contains": "Standalone Gemini CLI support is disabled"
      },
      "faults": [
        "missing-terminal"
      ]
    },
    {
      "id": "gemini-stale",
      "kind": "error",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/acp-profiles/run-case.mjs",
          "gemini-stale"
        ],
        "env": {
          "LMMOCK_ACP_SCENARIO": "fixtures/acp/gemini-stale.json"
        }
      },
      "expect": {
        "exit_code": 0,
        "error_class": "unknown",
        "stdout_contains": "Standalone Gemini CLI support is disabled"
      },
      "faults": [
        "session-stale"
      ]
    },
    {
      "id": "gemini-permission",
      "kind": "stream",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/acp-profiles/run-case.mjs",
          "gemini-permission"
        ],
        "env": {
          "LMMOCK_ACP_SCENARIO": "fixtures/acp/gemini-permission.json"
        }
      },
      "expect": {
        "exit_code": 0,
        "error_class": "unknown",
        "stdout_contains": "Standalone Gemini CLI support is disabled"
      }
    }
  ],
  "faults": [
    {
      "id": "auth-invalid",
      "surface": "process",
      "trigger": {
        "case_id": "gemini-auth"
      },
      "description": "Deterministic ACP auth fixture; no delay or vendor contact."
    },
    {
      "id": "missing-terminal",
      "surface": "stream",
      "trigger": {
        "case_id": "gemini-missing"
      },
      "description": "Deterministic ACP missing fixture; no delay or vendor contact."
    },
    {
      "id": "session-stale",
      "surface": "session",
      "trigger": {
        "case_id": "gemini-stale"
      },
      "description": "Deterministic ACP stale fixture; no delay or vendor contact."
    }
  ]
}
