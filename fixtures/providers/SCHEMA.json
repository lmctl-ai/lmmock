{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lmctl-ai/lmmock/blob/main/fixtures/providers/SCHEMA.json",
  "title": "lmmock provider fixture manifest",
  "description": "Versioned protocol and model-family fixture contract. Handler policy stays in lmcode; this file declares provenance, routes, test cases, and deterministic faults.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "jsonMap": { "type": "object", "additionalProperties": true },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "version"],
      "properties": {
        "kind": { "enum": ["public-spec", "sdk-types", "capture", "synthetic"] },
        "reference": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "note": { "type": "string" }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["chat", "reasoning", "tools", "stream", "json", "embedding", "image", "audio", "video", "realtime", "search", "rerank"] } },
        "price_record": { "type": ["string", "null"] }
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "handler", "config"],
      "properties": {
        "kind": { "enum": ["http", "stdio"] },
        "handler": { "type": "string", "minLength": 1 },
        "config": { "type": "string", "minLength": 1 },
        "url_env": { "type": "string", "minLength": 1 },
        "binary": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "method", "path", "annotation", "sam"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "pattern": "^[A-Z]+$" },
        "path": { "type": "string", "pattern": "^/" },
        "annotation": { "type": "string", "minLength": 1 },
        "sam": { "type": "string", "minLength": 1 },
        "content_types": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "httpRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "method", "path"],
      "properties": {
        "kind": { "const": "http" },
        "method": { "type": "string", "pattern": "^[A-Z]+$" },
        "path": { "type": "string", "pattern": "^/" },
        "headers": { "$ref": "#/$defs/stringMap" },
        "body": {},
        "raw_body": { "type": "string" }
      }
    },
    "processRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "executable", "argv"],
      "properties": {
        "kind": { "const": "process" },
        "executable": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "items": { "type": "string" } },
        "env": { "$ref": "#/$defs/stringMap" },
        "stdin": { "type": "string" },
        "cwd": { "type": "string" }
      }
    },
    "expect": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": { "$ref": "#/$defs/stringMap" },
        "json": { "$ref": "#/$defs/jsonMap" },
        "body_contains": { "type": "string" },
        "stream": {"type": "object", "additionalProperties": false, "required": ["dialect", "text", "input_tokens", "output_tokens"], "properties": {"dialect": {"enum": ["anthropic", "gemini", "ollama", "miniplayer"]}, "text": {"type": "string"}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}},
        "events": { "type": "array", "items": { "type": "string" } },
        "exit_code": { "type": "integer" },
        "stdout_contains": { "type": "string" },
        "stderr_contains": { "type": "string" },
        "error_class": { "enum": ["quota_exhausted", "binary_missing", "auth_required", "upstream_undisclosed", "upstream_throttled", "model_not_offered", "stale_session", "transport_interrupted", "context_exhausted", "receiver_busy", "holder_died", "self_session_unregistered", "unknown"] },
        "model": { "type": "string" },
        "usage": {
          "type": "object", "additionalProperties": true,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "prompt_tokens": { "type": "integer", "minimum": 0 },
            "cached_input_tokens": { "type": "integer", "minimum": 0 },
            "cache_write_input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "completion_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 },
            "reasoning_output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "tool_calls": { "type": "array", "items": { "type": "object" } },
        "effects": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "exists"],
            "properties": { "path": { "type": "string" }, "exists": { "type": "boolean" }, "contains": { "type": "string" } }
          }
        }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "request", "expect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["success", "error", "usage", "model", "tool", "stream"] },
        "request": { "oneOf": [{ "$ref": "#/$defs/httpRequest" }, { "$ref": "#/$defs/processRequest" }] },
        "expect": { "$ref": "#/$defs/expect" },
        "faults": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "fault": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "surface", "trigger", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "surface": { "enum": ["http", "process", "stream", "session"] },
        "trigger": {
          "type": "object", "additionalProperties": false,
          "required": ["case_id"],
          "properties": { "case_id": { "type": "string" }, "occurrence": { "type": "integer", "minimum": 1 }, "model": { "type": "string" } }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "dialect", "source", "server", "models", "routes", "cases", "faults"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "dialect": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "transport"],
          "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "transport": { "enum": ["http", "sse", "ndjson", "jsonl", "json-rpc", "acp", "msp", "custom"] } }
        },
        "source": { "$ref": "#/$defs/source" },
        "server": { "$ref": "#/$defs/server" },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } },
        "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
        "faults": { "type": "array", "items": { "$ref": "#/$defs/fault" } }
      }
    }
  }
}
