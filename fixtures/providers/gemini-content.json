    "version": "v1beta",
    "retrieved": "2026-10-31",
    "note": "Gemini REST generateContent and SSE streamGenerateContent"
  },
  "server": {
    "kind": "http",
    "handler": "fixtures/gemini/handler.lms",
    "config": "fixtures/gemini/wire.json",
