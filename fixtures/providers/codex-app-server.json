{
  "schema_version": 1,
  "id": "codex-app-server",
  "dialect": {
    "id": "codex-app-server",
    "version": "lmctl-0.2.448",
    "transport": "json-rpc"
  },
  "source": {
    "kind": "synthetic",
    "reference": "https://developers.openai.com/codex/app-server",
    "version": "lmctl-0.2.448; mono584fee2a adapter",
    "retrieved": "2026-10-31",
    "note": "Synthetic stdio only. Exact tested client is published npm0.2.448. Foreign turn events are ignored; malformed usage remains provider success with unavailable accounting. Specialized protocol/usage error classes are NOT claimed; strict client controls record this unmet requirement."
  },
  "server": {
    "kind": "stdio",
