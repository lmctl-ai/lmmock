  "cases": [
    {
      "id": "success",
      "kind": "usage",
      "request": {
        "kind": "process",
        "executable": "node",
        "argv": [
          "tests/providers/codex/manifest.mjs"
        ],
        "env": {
          "LMMOCK_CODEX_CASE": "success",
          "LMMOCK_CODEX_MODE": "agent",
          "LMMOCK_CODEX_MODEL": "gpt-5.6-sol"
        }
      },
      "expect": {
        "exit_code": 0,
        "json": {
          "provider.status": "ok",
          "row_count": 1
        },
        "stdout_contains": "pong",
        "usage": {
          "input_tokens": 100,
          "cached_input_tokens": 30,
          "output_tokens": 12,
          "reasoning_output_tokens": 4
