p = _lmcode_ schema="../../internal/rpcstdio/presets/schema.json";
fn cfg() -> Json {return json_parse(config());}
fn emit_events(x: RPC, c: Json) -> void {
 let events=c.get("events");for(i in range(0,events.len())){x.emit(events.at(i).to_json());}
 if(c.has("stderr")){x.abort(c.get("stderr").as_string());}
 if(c.has("close")){if(c.get("close").as_bool()){x.close();}}
}
@start fn start(x: RPC) -> void implements RPCHandler {
 let c=cfg();let args=json_parse(x.params()).get("argv");let stream=false;
 for(i in range(0,args.len())){if(args.at(i).as_string()=="--input-format"){stream=true;}}
 file_append(c.get("audit").as_string(),x.params()+"\n");
 if(!stream){
  let seed=c.get("seed");if(!str_contains(x.params(),seed.get("expect").as_string())){x.abort("seed prompt mismatch");}
  if(seed.has("files")){let files=seed.get("files");for(i in range(0,files.len())){let f=files.at(i);file_write(f.get("path").as_string(),f.get("text").as_string());}}
  emit_events(x,seed);x.close();
 }else{emit_events(x,c.get("init"));}
}
@message fn message(x: RPC) -> void implements RPCHandler {
 let c=cfg();let request=json_parse(x.message());
 if(request.get("type").as_string()!="user"||request.get("message").get("role").as_string()!="user"){x.abort("expected user JSONL input");}
 let turn=x.next("turn");let turns=c.get("turns");if(turn>turns.len()){x.abort("unscripted turn");}
 let cell=turns.at(turn-1);if(!str_contains(request.get("message").get("content").as_string(),cell.get("expect").as_string())){x.abort("turn prompt mismatch");}
 file_append(c.get("audit").as_string(),x.message()+"\n");emit_events(x,cell);
}
bind("$start","start");bind("$message","message");
end _lmcode_
savedsl(p, ARGV[0]);
