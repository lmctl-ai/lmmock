# Synthetic OAuth 2 authorization-code + PKCE and client-credentials server.
p = _lmcode_ schema="../../schema.json";
fn text(j: Json, key: string, fallback: string) -> string { let v = fallback; if (j.has(key)) { v = j.get(key).as_string(); } return v; }
fn num(j: Json, key: string, fallback: int) -> int { let v = fallback; if (j.has(key)) { v = j.get(key).as_int(); } return v; }
fn field(x: Exchange, key: string) -> string {
 let body = x.body(); let v = "";
 if (str_starts_with(str_trim(body), "{")) { let j = json_parse(body); if (j.has(key)) { v = j.get(key).as_string(); } }
 else { v = form_get(body, key); }
 return v;
}
fn valid_port(p: string) -> bool {
 let n = str_len(p); let ok = n >= 1 && n <= 5 && str_substr(p, 0, 1) != "0";
 if (ok) {
  for (i in range(0, n)) {
   if (!str_contains("0123456789", str_substr(p, i, 1))) { ok = false; }
  }
 }
 if (ok) {
  let v = json_parse(p).as_int();
  ok = v >= 1 && v <= 65535;
 }
 return ok;
}
fn redirect_matches(registered: string, actual: string) -> bool {
 let matched = registered == actual;
 if (!matched && (registered == "http://127.0.0.1/callback" || registered == "http://127.0.0.1:0/callback")) {
  if (str_starts_with(actual, "http://127.0.0.1:") && str_ends_with(actual, "/callback") && str_len(actual) > 26) {
   matched = valid_port(str_substr(actual, 17, str_len(actual) - 26));
  }
 }
 return matched;
}
fn valid_verifier(v: string) -> bool {
 let n = str_len(v); let ok = n >= 43 && n <= 128;
 if (ok) {
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
  for (i in range(0, n)) {
   if (!str_contains(alphabet, str_substr(v, i, 1))) { ok = false; }
  }
 }
 return ok;
}
fn oauth_error(x: Exchange, status: int, code: string) -> void { x.status(status); x.json("{\"error\":" + json_quote(code) + "}"); }
fn issue(x: Exchange, client: string, scope: string, c: Json) -> void {
 let accessToken = "oauth_mock_" + random_token(); let seconds = num(c, "accessTokenLifetimeSeconds", 3600);
 x.set("token:" + accessToken, "{\"clientId\":" + json_quote(client) + ",\"scope\":" + json_quote(scope) + "}");
 x.json("{\"access_token\":" + json_quote(accessToken) + ",\"token_type\":\"Bearer\",\"expires_in\":" + str(seconds) + ",\"scope\":" + json_quote(scope) + "}");
}
fn clients_cfg(c: Json) -> Json {
 let out = json_parse("{\"fixture-public-client\":{\"secret\":\"fixture-client-secret\",\"redirectUris\":[\"http://client.example.test/callback\",\"http://127.0.0.1/callback\"]}}");
 if (c.has("clients")) { out = c.get("clients"); }
 return out;
}
@authorize
fn authorize(x: Exchange) -> void implements Handler {
 let c = json_parse(config()); let clients = clients_cfg(c); let id = x.query("client_id");
 if (!clients.has(id)) { oauth_error(x, 400, "invalid_client"); }
 else {
  let redirect = x.query("redirect_uri"); let client = clients.get(id); let uris = client.get("redirectUris"); let allowed = false;
  for (i in range(0, uris.len())) { if (redirect_matches(uris.at(i).as_string(), redirect)) { allowed = true; } }
  if (!allowed) { oauth_error(x, 400, "invalid_request"); }
  else {
   let sep = "?"; if (str_contains(redirect, "?")) { sep = "&"; }
   let state = x.query("state"); let stateParam = "";
   if (state != "") { stateParam = "&state=" + url_encode(state); }
   if (x.query("response_type") != "code") { x.status(302); x.set_header("Location", redirect + sep + "error=unsupported_response_type" + stateParam); }
   else if (state == "" || x.query("code_challenge") == "" || x.query("code_challenge_method") != "S256") { x.status(302); x.set_header("Location", redirect + sep + "error=invalid_request" + stateParam); }
   else {
    let code = "oauth_code_" + random_token(); let expiry = now_ms() + num(c, "codeLifetimeMs", 60000);
    let data = "{\"clientId\":" + json_quote(id) + ",\"redirectUri\":" + json_quote(redirect) + ",\"state\":" + json_quote(state) + ",\"scope\":" + json_quote(x.query("scope")) + ",\"challenge\":" + json_quote(x.query("code_challenge")) + ",\"expiresAt\":" + str(expiry) + "}";
    x.set("code:" + code, data);
    x.status(302); x.set_header("Location", redirect + sep + "code=" + url_encode(code) + "&state=" + url_encode(state));
   }
  }
 }
}
@token_endpoint
fn token_endpoint(x: Exchange) -> void implements Handler {
 let c = json_parse(config()); let grant = field(x, "grant_type");
 let id = field(x, "client_id"); let secret = field(x, "client_secret"); let hasBasic = str_starts_with(x.header("Authorization"), "Basic ");
 if (hasBasic) { id = basic_id(x.header("Authorization")); secret = basic_secret(x.header("Authorization")); }
 let clients = clients_cfg(c);
 if (!clients.has(id)) { oauth_error(x, 401, "invalid_client"); }
 else if (grant == "client_credentials") {
  let client = clients.get(id);
  if (!secure_equal(secret, text(client, "secret", ""))) { oauth_error(x, 401, "invalid_client"); }
  else { issue(x, id, field(x, "scope"), c); }
 }
 else if (grant == "authorization_code") {
  let client = clients.get(id);
  if ((hasBasic || secret != "") && !secure_equal(secret, text(client, "secret", ""))) { oauth_error(x, 401, "invalid_client"); }
  else {
   let code = field(x, "code"); let data = x.take("code:" + code);
   if (data == "") { oauth_error(x, 400, "invalid_grant"); }
   else {
    let rec = json_parse(data); let verifier = field(x, "code_verifier");
    if (text(rec, "clientId", "") != id || text(rec, "redirectUri", "") != field(x, "redirect_uri") || now_ms() >= rec.get("expiresAt").as_int() || !valid_verifier(verifier) || !secure_equal(sha256_url(verifier), text(rec, "challenge", ""))) { oauth_error(x, 400, "invalid_grant"); }
    else { issue(x, id, text(rec, "scope", ""), c); }
   }
  }
 }
 else { oauth_error(x, 400, "unsupported_grant_type"); }
}
@userinfo
fn userinfo(x: Exchange) -> void implements Handler {
 let header = x.header("Authorization"); let tokenValue = "";
 if (str_starts_with(header, "Bearer ")) { tokenValue = str_substr(header, 7, str_len(header)); }
 let raw = x.get("token:" + tokenValue);
 if (raw == "") { x.set_header("WWW-Authenticate", "Bearer realm=\"fixture-idp\""); oauth_error(x, 401, "invalid_token"); }
 else { let rec = json_parse(raw); x.json("{\"sub\":\"fixture-user\",\"client_id\":" + json_quote(text(rec, "clientId", "")) + ",\"scope\":" + json_quote(text(rec, "scope", "")) + "}"); }
}
route("GET", "/authorize", "authorize");
route("POST", "/oauth/token", "token_endpoint");
route("GET", "/oauth/userinfo", "userinfo");
end _lmcode_
r = run_lmcode(p, {command: concat(["lmmock", "exec", "--lmcode", "$DSLFILE", "--"], ARGV)}); require(r.ok, "mock client failed");
if (r.result != null) { print(r.result.stdout); }
