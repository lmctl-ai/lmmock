@gmail_send_message
fn gmail_send_message(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let req = json_parse(x.body());
  let rawB64 = text(req, "raw", "");
  if (rawB64 == "") {
   api_error(x, 400, "invalidArgument", "raw message required");
  } else {
   let mimeStr = str_replace(b64url_decode(rawB64), "\r\n", "\n");
   let parts = str_split(mimeStr, "\n\n");
   let hdrBlock = parts.at(0);
   let bodyTxt = "";
   if (parts.len() > 1) { bodyTxt = parts.at(1); }
   let toAddr = "";
   let subj = "";
   let hLines = str_split(hdrBlock, "\n");
   for (i in range(0, hLines.len())) {
    let line = str_trim(hLines.at(i));
    let ll = str_lower(line);
    if (str_starts_with(ll, "to:")) { toAddr = str_trim(str_substr(line, 3, str_len(line) - 3)); }
    else if (str_starts_with(ll, "subject:")) { subj = str_trim(str_substr(line, 8, str_len(line) - 8)); }
   }
   let db = database(x);
   let id = "msg_" + str(9000 + x.increment("gmail_seq"));
   let tid = text(req, "threadId", "thr_" + id);
   if (tid == "") { tid = "thr_" + id; }
   let snip = str_trim(bodyTxt);
   if (str_len(snip) > 100) { snip = str_substr(snip, 0, 100); }
   let fromAddr = text(db, "gmailEmail", "engineering@acme.example");
   let msg = json_parse("{\"id\":" + json_quote(id) + ",\"threadId\":" + json_quote(tid) + ",\"labelIds\":[\"SENT\"],\"snippet\":" + json_quote(snip) + ",\"payload\":{\"mimeType\":\"text/plain\",\"headers\":[{\"name\":\"From\",\"value\":" + json_quote(fromAddr) + "},{\"name\":\"To\",\"value\":" + json_quote(toAddr) + "},{\"name\":\"Subject\",\"value\":" + json_quote(subj) + "},{\"name\":\"Date\",\"value\":\"Mon, 23 Nov 2026 15:00:00 -0600\"}],\"body\":{\"data\":" + json_quote(b64url_encode(str_trim(bodyTxt))) + "}}}");
   db = put(db, "gmailMessages", put(db.get("gmailMessages"), id, msg));
   db = put(db, "gmailOrder", append(db.get("gmailOrder"), json_parse(json_quote(id))));
   save(x, db);
   x.json(msg.to_json());
  }
 }
}

@gmail_modify_message
fn gmail_modify_message(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let id = x.param("id");
  let db = database(x);
  let msgs = db.get("gmailMessages");
  if (!msgs.has(id) || is_deleted(msgs.get(id))) {
   api_error(x, 404, "notFound", "message not found: " + id);
  } else {
   let req = json_parse(x.body());
   let msg = msgs.get(id);
   let cur = json_parse("[]");
   if (msg.has("labelIds")) { cur = msg.get("labelIds"); }
   let rem = member(req, "removeLabelIds");
   let add = member(req, "addLabelIds");
   let next = json_parse("[]");
   for (i in range(0, cur.len())) {
    let lbl = cur.at(i).as_string();
    let drop = false;
    if (rem.kind() == "array") {
     for (ri in range(0, rem.len())) { if (rem.at(ri).as_string() == lbl) { drop = true; } }
    }
    if (!drop) { next = append(next, json_parse(json_quote(lbl))); }
   }
   if (add.kind() == "array") {
    for (ai in range(0, add.len())) {
     let al = add.at(ai).as_string();
     let exists = false;
     for (ni in range(0, next.len())) { if (next.at(ni).as_string() == al) { exists = true; } }
     if (!exists) { next = append(next, json_parse(json_quote(al))); }
    }
   }
   msg = put(msg, "labelIds", next);
   db = put(db, "gmailMessages", put(msgs, id, msg));
   save(x, db);
   x.json(msg.to_json());
  }
 }
}

@gmail_trash_message
fn gmail_trash_message(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let id = x.param("id");
  let db = database(x);
  let msgs = db.get("gmailMessages");
  if (!msgs.has(id) || is_deleted(msgs.get(id))) {
   api_error(x, 404, "notFound", "message not found: " + id);
  } else {
   let msg = msgs.get(id);
   let cur = json_parse("[]");
   if (msg.has("labelIds")) { cur = msg.get("labelIds"); }
   let next = json_parse("[]");
   let hasTrash = false;
   for (i in range(0, cur.len())) {
    let lbl = cur.at(i).as_string();
    if (lbl != "INBOX") {
     if (lbl == "TRASH") { hasTrash = true; }
     next = append(next, json_parse(json_quote(lbl)));
    }
   }
   if (!hasTrash) { next = append(next, json_parse("\"TRASH\"")); }
   msg = put(msg, "labelIds", next);
   db = put(db, "gmailMessages", put(msgs, id, msg));
   save(x, db);
   x.json(msg.to_json());
  }
 }
}

@gmail_get_thread
fn gmail_get_thread(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let tid = x.param("id");
  let db = database(x);
  let msgs = db.get("gmailMessages");
  let order = db.get("gmailOrder");
  let list = json_parse("[]");
  for (i in range(0, order.len())) {
   let id = order.at(i).as_string();
   if (msgs.has(id)) {
    let m = msgs.get(id);
    if (!is_deleted(m) && text(m, "threadId", "") == tid) { list = append(list, m); }
   }
  }
  if (list.len() == 0) { api_error(x, 404, "notFound", "thread not found: " + tid); }
  else { x.json("{\"id\":" + json_quote(tid) + ",\"messages\":" + list.to_json() + "}"); }
 }
}

@gmail_get_attachment
fn gmail_get_attachment(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let key = x.param("id") + "/" + x.param("attId");
  let db = database(x);
  let atts = db.get("gmailAttachments");
  if (!atts.has(key)) { api_error(x, 404, "notFound", "attachment not found: " + key); }
  else {
   let data = atts.get(key).as_string();
   x.json("{\"attachmentId\":" + json_quote(x.param("attId")) + ",\"size\":54,\"data\":" + json_quote(data) + "}");
  }
 }
}

