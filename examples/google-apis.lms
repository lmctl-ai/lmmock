p = _lmcode_ schema="schema.json";

fn text(j: Json, k: string, fallback: string) -> string {
 let v = fallback;
 if (j.kind() == "object" && j.has(k) && j.get(k).kind() == "string") { v = j.get(k).as_string(); }
 return v;
}
fn num(j: Json, k: string, fallback: int) -> int {
 let v = fallback;
 if (j.kind() == "object" && j.has(k)) {
  let fk = j.get(k);
  if (fk.kind() == "int") { v = fk.as_int(); }
  else if (fk.kind() == "string" && str_is_int(fk.as_string())) { v = str_to_int(fk.as_string()); }
 }
 return v;
}
fn member(j: Json, k: string) -> Json {
 let v = json_parse("{}");
 if (j.kind() == "object" && j.has(k) && j.get(k).kind() != "null") { v = j.get(k); }
 return v;
}
fn pointer(s: string) -> string { return str_replace(str_replace(s, "~", "~0"), "/", "~1"); }
fn put(j: Json, k: string, value: Json) -> Json { return json_with(j, "/" + pointer(k), value); }
fn append(j: Json, value: Json) -> Json { return json_with(j, "/-", value); }
fn is_deleted(obj: Json) -> bool {
 let d = false;
 if (obj.kind() == "object" && obj.has("_deleted") && obj.get("_deleted").kind() == "bool") { d = obj.get("_deleted").as_bool(); }
 return d;
}
fn database(x: Exchange) -> Json {
 let raw = x.get("database");
 if (raw == "") {
  raw = ${json_stringify(seed)};
  x.set("database", raw);
 }
 return json_parse(raw);
}
fn save(x: Exchange, db: Json) -> void { x.set("database", db.to_json()); }

fn api_error(x: Exchange, status: int, reason: string, msg: string) -> void {
 x.status(status);
 x.json("{\"error\":{\"code\":" + str(status) + ",\"message\":" + json_quote(msg) + ",\"errors\":[{\"reason\":" + json_quote(reason) + ",\"message\":" + json_quote(msg) + "}]}}");
}

fn allowed(x: Exchange) -> bool {
 let cfgRaw = config();
 let requireAuth = true;
 let token = "fixture-token";
 if (str_starts_with(str_trim(cfgRaw), "{")) {
  let c = json_parse(cfgRaw);
  if (c.has("token") && c.get("token").kind() == "string") { token = c.get("token").as_string(); }
  if (c.has("requireAuth") && c.get("requireAuth").kind() == "bool") { requireAuth = c.get("requireAuth").as_bool(); }
 }
 let ok = true;
 if (requireAuth) {
  ok = secure_equal(x.header("Authorization"), "Bearer " + token);
 }
 if (!ok) {
  api_error(x, 401, "authError", "Invalid Credentials");
 } else if (x.header("X-Lmmock-Fault") == "429") {
  ok = false;
  x.set_header("Retry-After", "1");
  api_error(x, 429, "rateLimitExceeded", "Quota exceeded for fixture project");
 } else if (x.header("X-Lmmock-Fault") == "500") {
  ok = false;
  api_error(x, 500, "backendError", "Fixture internal server error");
 }
 return ok;
}

fn norm_prop(id: string) -> string {
 let s = id;
 if (!str_starts_with(s, "properties/")) { s = "properties/" + s; }
 return s;
}
fn norm_acc(id: string) -> string {
 let s = id;
 if (!str_starts_with(s, "accounts/")) { s = "accounts/" + s; }
 return s;
}
fn parse_multipart_json(body: string) -> string {
 let trimmed = str_trim(body);
 let out = "{}";
 if (str_starts_with(trimmed, "{")) {
  out = trimmed;
 } else if (str_contains(body, "{")) {
  let start = 0;
  let n = str_len(body);
  let found = false;
  for (i in range(0, n)) {
   if (!found && str_substr(body, i, 1) == "{") {
    start = i;
    found = true;
   }
  }
  let rest = str_substr(body, start, n - start);
  if (str_contains(rest, "\r\n--")) {
   rest = str_split(rest, "\r\n--").at(0);
  } else if (str_contains(rest, "\n--")) {
   rest = str_split(rest, "\n--").at(0);
  }
  out = str_trim(rest);
 }
 return out;
}
fn has_csv_part(csv: string, target: string) -> bool {
 let parts = str_split(csv, ",");
 let hit = false;
 for (i in range(0, parts.len())) {
  if (str_trim(parts.at(i)) == target) { hit = true; }
 }
 return hit;
}

# --- GA4 Admin Handlers ---

@ga_account_summaries
fn ga_account_summaries(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let db = database(x);
  let accs = db.get("accounts");
  let props = db.get("properties");
  let accOrder = db.get("accountOrder");
  let propOrder = db.get("propertyOrder");
  let summaries = json_parse("[]");
  for (ai in range(0, accOrder.len())) {
   let ak = accOrder.at(ai).as_string();
   let acc = accs.get(ak);
   let psums = json_parse("[]");
   for (pi in range(0, propOrder.len())) {
    let pk = propOrder.at(pi).as_string();
    if (props.has(pk)) {
     let pr = props.get(pk);
     if (!is_deleted(pr) && (text(pr, "parent", "") == ak || text(pr, "account", "") == ak)) {
      psums = append(psums, json_parse("{\"property\":" + json_quote(text(pr, "name", pk)) + ",\"displayName\":" + json_quote(text(pr, "displayName", "")) + ",\"propertyType\":" + json_quote(text(pr, "propertyType", "PROPERTY_TYPE_ORDINARY")) + ",\"parent\":" + json_quote(text(pr, "parent", ak)) + "}"));
     }
    }
   }
   let sumName = str_replace(ak, "accounts/", "accountSummaries/");
   summaries = append(summaries, json_parse("{\"name\":" + json_quote(sumName) + ",\"account\":" + json_quote(ak) + ",\"displayName\":" + json_quote(text(acc, "displayName", "")) + ",\"propertySummaries\":" + psums.to_json() + "}"));
  }
  x.json("{\"accountSummaries\":" + summaries.to_json() + "}");
 }
}

