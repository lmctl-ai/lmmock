@yt_add_playlist_item
fn yt_add_playlist_item(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let req = json_parse(x.body());
  let snip = member(req, "snippet");
  let pid = text(snip, "playlistId", "");
  let resId = member(snip, "resourceId");
  let vid = text(resId, "videoId", "");
  let db = database(x);
  let pls = db.get("playlists");
  if (pid == "" || !pls.has(pid) || is_deleted(pls.get(pid))) {
   api_error(x, 404, "playlistNotFound", "playlist not found: " + pid);
  } else {
   let title = vid;
   if (db.get("videos").has(vid)) { title = text(db.get("videos").get(vid).get("snippet"), "title", vid); }
   let itemId = "pli_" + str(9000 + x.increment("yt_pli_seq"));
   let item = json_parse("{\"kind\":\"youtube#playlistItem\",\"id\":" + json_quote(itemId) + ",\"snippet\":{\"playlistId\":" + json_quote(pid) + ",\"title\":" + json_quote(title) + ",\"resourceId\":{\"kind\":\"youtube#video\",\"videoId\":" + json_quote(vid) + "}},\"contentDetails\":{\"videoId\":" + json_quote(vid) + "}}");
   let pitems = db.get("playlistItems");
   let list = json_parse("[]");
   if (pitems.has(pid)) { list = pitems.get(pid); }
   list = append(list, item);
   db = put(db, "playlistItems", put(pitems, pid, list));
   let pl = pls.get(pid);
   let newCount = list.len();
   pl = put(pl, "contentDetails", json_parse("{\"itemCount\":" + str(newCount) + "}"));
   db = put(db, "playlists", put(pls, pid, pl));
   save(x, db);
   x.json(item.to_json());
  }
 }
}

