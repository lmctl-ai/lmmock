   let measId = "G-LM" + str(numId);
   let st = json_parse("{\"name\":" + json_quote(name) + ",\"type\":" + json_quote(stType) + ",\"displayName\":" + json_quote(disp) + ",\"webStreamData\":{\"measurementId\":" + json_quote(measId) + ",\"defaultUri\":" + json_quote(defaultUri) + "}}");
   db = put(db, "dataStreams", put(db.get("dataStreams"), name, st));
   db = put(db, "streamOrder", append(db.get("streamOrder"), json_parse(json_quote(name))));
   save(x, db);
   x.json(st.to_json());
  }
 }
}

