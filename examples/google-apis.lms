# --- YouTube Analytics API v2 ---

fn yt_col_val(r: Json, col: string) -> Json {
 let out = json_parse(str(num(r, col, 0)));
 if (col == "day" || col == "video" || col == "country") {
  out = json_parse(json_quote(text(r, col, "")));
 }
 return out;
}

@yt_analytics_reports
fn yt_analytics_reports(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let dimsCsv = x.query("dimensions");
  let metsCsv = x.query("metrics");
  if (metsCsv == "") { metsCsv = "views,estimatedMinutesWatched"; }
  let filterParam = x.query("filters");
  let filterVideo = "";
  if (str_starts_with(filterParam, "video==")) {
   filterVideo = str_trim(str_substr(filterParam, 7, str_len(filterParam) - 7));
  }
  let headers = json_parse("[]");
  let colNames = json_parse("[]");
  if (str_trim(dimsCsv) != "") {
   let dp = str_split(dimsCsv, ",");
   for (i in range(0, dp.len())) {
    let d = str_trim(dp.at(i));
    if (d != "") {
     colNames = append(colNames, json_parse(json_quote(d)));
     headers = append(headers, json_parse("{\"name\":" + json_quote(d) + ",\"columnType\":\"DIMENSION\",\"dataType\":\"STRING\"}"));
    }
   }
  }
  let mp = str_split(metsCsv, ",");
  for (i in range(0, mp.len())) {
   let m = str_trim(mp.at(i));
   if (m != "") {
    colNames = append(colNames, json_parse(json_quote(m)));
    headers = append(headers, json_parse("{\"name\":" + json_quote(m) + ",\"columnType\":\"METRIC\",\"dataType\":\"INTEGER\"}"));
   }
  }
  let db = database(x);
  let raw = db.get("ytAnalyticsRows");
  let rows = json_parse("[]");
  for (i in range(0, raw.len())) {
   let r = raw.at(i);
   if (filterVideo == "" || text(r, "video", "") == filterVideo) {
    let row = json_parse("[]");
    for (ci in range(0, colNames.len())) {
     row = append(row, yt_col_val(r, colNames.at(ci).as_string()));
    }
    rows = append(rows, row);
   }
  }
  x.json("{\"kind\":\"youtubeAnalytics#resultTable\",\"columnHeaders\":" + headers.to_json() + ",\"rows\":" + rows.to_json() + "}");
 }
}

# --- Gmail API v1 Handlers ---

fn b64url_decode(s: string) -> string {
 let std = str_replace(str_replace(s, "-", "+"), "_", "/");
 let rem = str_len(std) % 4;
 if (rem == 2) { std = std + "=="; }
 else if (rem == 3) { std = std + "="; }
 return str_base64_decode(std);
}

fn b64url_encode(s: string) -> string {
 let b = str_base64_encode(s);
 b = str_replace(str_replace(str_replace(b, "+", "-"), "/", "_"), "=", "");
 return b;
}

fn gmail_has_label(msg: Json, target: string) -> bool {
 let hit = false;
 if (msg.has("labelIds") && msg.get("labelIds").kind() == "array") {
  let ls = msg.get("labelIds");
  let lt = str_lower(target);
  for (i in range(0, ls.len())) {
   if (str_lower(ls.at(i).as_string()) == lt) { hit = true; }
  }
 }
 return hit;
}

fn gmail_hdr(msg: Json, name: string) -> string {
 let val = "";
 if (msg.has("payload") && msg.get("payload").has("headers")) {
  let hs = msg.get("payload").get("headers");
  let ln = str_lower(name);
  for (i in range(0, hs.len())) {
   let h = hs.at(i);
   if (str_lower(text(h, "name", "")) == ln) { val = text(h, "value", ""); }
  }
 }
 return val;
}

fn gmail_body_text(msg: Json) -> string {
 let out = text(msg, "snippet", "");
 if (msg.has("payload")) {
  let pl = msg.get("payload");
  if (pl.has("body") && text(pl.get("body"), "data", "") != "") {
   out = b64url_decode(text(pl.get("body"), "data", ""));
  } else if (pl.has("parts") && pl.get("parts").kind() == "array") {
   let ps = pl.get("parts");
   for (i in range(0, ps.len())) {
    let p = ps.at(i);
    if (text(p, "mimeType", "") == "text/plain" && p.has("body") && text(p.get("body"), "data", "") != "") {
     out = b64url_decode(text(p.get("body"), "data", ""));
    }
   }
  }
 }
 return out;
}

fn strip_quotes(s: string) -> string {
 return str_replace(str_replace(s, "\"", ""), "'", "");
}

fn gmail_matches_query(msg: Json, q: string) -> bool {
 let ok = true;
 if (str_trim(q) != "") {
  let subj = str_lower(gmail_hdr(msg, "Subject"));
  let from = str_lower(gmail_hdr(msg, "From"));
  let to = str_lower(gmail_hdr(msg, "To"));
  let body = str_lower(gmail_body_text(msg));
  let snip = str_lower(text(msg, "snippet", ""));
  let toks = str_split(str_trim(q), " ");
  for (i in range(0, toks.len())) {
   let lt = str_lower(str_trim(toks.at(i)));
   if (lt != "") {
    if (lt == "is:unread") { if (!gmail_has_label(msg, "UNREAD")) { ok = false; } }
    else if (lt == "is:read") { if (gmail_has_label(msg, "UNREAD")) { ok = false; } }
    else if (lt == "is:starred") { if (!gmail_has_label(msg, "STARRED")) { ok = false; } }
    else if (str_starts_with(lt, "from:")) {
     if (!str_contains(from, strip_quotes(str_substr(lt, 5, str_len(lt) - 5)))) { ok = false; }
    } else if (str_starts_with(lt, "to:")) {
     if (!str_contains(to, strip_quotes(str_substr(lt, 3, str_len(lt) - 3)))) { ok = false; }
    } else if (str_starts_with(lt, "subject:")) {
     if (!str_contains(subj, strip_quotes(str_substr(lt, 8, str_len(lt) - 8)))) { ok = false; }
    } else if (str_starts_with(lt, "label:")) {
     if (!gmail_has_label(msg, str_substr(lt, 6, str_len(lt) - 6))) { ok = false; }
    } else if (str_starts_with(lt, "in:")) {
     if (!gmail_has_label(msg, str_substr(lt, 3, str_len(lt) - 3))) { ok = false; }
    } else {
     if (!str_contains(subj, lt) && !str_contains(from, lt) && !str_contains(body, lt) && !str_contains(snip, lt)) { ok = false; }
    }
   }
  }
 }
 return ok;
}

@gmail_profile
fn gmail_profile(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let db = database(x);
  let msgs = db.get("gmailMessages");
  let order = db.get("gmailOrder");
  let count = 0;
  for (i in range(0, order.len())) {
   let id = order.at(i).as_string();
   if (msgs.has(id) && !is_deleted(msgs.get(id))) { count = count + 1; }
  }
  x.json("{\"emailAddress\":" + json_quote(text(db, "gmailEmail", "engineering@acme.example")) + ",\"messagesTotal\":" + str(count) + ",\"threadsTotal\":" + str(count) + ",\"historyId\":\"900100\"}");
 }
}

