    let vk = order.at(i).as_string();
    if (videos.has(vk) && !is_deleted(videos.get(vk))) { items = append(items, videos.get(vk)); }
   }
  }
  x.json("{\"kind\":\"youtube#videoListResponse\",\"items\":" + items.to_json() + "}");
 }
}

@yt_upload_video
fn yt_upload_video(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let metaJson = parse_multipart_json(x.body());
  let meta = json_parse(metaJson);
  let snipIn = member(meta, "snippet");
  let statIn = member(meta, "status");
  let title = text(snipIn, "title", "Untitled Video");
  let desc = text(snipIn, "description", "");
  let catId = text(snipIn, "categoryId", "28");
  let tags = json_parse("[]");
  if (snipIn.has("tags") && snipIn.get("tags").kind() == "array") { tags = snipIn.get("tags"); }
  let privacy = text(statIn, "privacyStatus", "private");
  let idNum = 9000 + x.increment("yt_seq");
  let vid = "vid_" + str(idNum);
  let video = json_parse("{\"kind\":\"youtube#video\",\"id\":" + json_quote(vid) + ",\"snippet\":{\"title\":" + json_quote(title) + ",\"description\":" + json_quote(desc) + ",\"channelId\":\"UC_ACME_DEV\",\"channelTitle\":\"Acme Engineering\",\"publishedAt\":\"2026-11-14T22:00:00Z\",\"categoryId\":" + json_quote(catId) + ",\"tags\":" + tags.to_json() + "},\"status\":{\"privacyStatus\":" + json_quote(privacy) + "},\"contentDetails\":{\"duration\":\"PT0M30S\"},\"statistics\":{\"viewCount\":\"0\",\"likeCount\":\"0\",\"commentCount\":\"0\"}}");
  let db = database(x);
  db = put(db, "videos", put(db.get("videos"), vid, video));
  db = put(db, "videoOrder", append(db.get("videoOrder"), json_parse(json_quote(vid))));
  save(x, db);
  x.json(video.to_json());
 }
}

@yt_update_video
fn yt_update_video(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let req = json_parse(x.body());
  let vid = text(req, "id", "");
  let db = database(x);
  let videos = db.get("videos");
  if (vid == "" || !videos.has(vid) || is_deleted(videos.get(vid))) {
   api_error(x, 404, "videoNotFound", "video not found: " + vid);
  } else {
   let cur = videos.get(vid);
   if (req.has("snippet")) {
    let rs = req.get("snippet");
    let cs = cur.get("snippet");
    if (text(rs, "title", "") != "") { cs = put(cs, "title", rs.get("title")); }
    if (rs.has("description")) { cs = put(cs, "description", rs.get("description")); }
    if (rs.has("tags") && rs.get("tags").kind() == "array") { cs = put(cs, "tags", rs.get("tags")); }
    if (text(rs, "categoryId", "") != "") { cs = put(cs, "categoryId", rs.get("categoryId")); }
    cur = put(cur, "snippet", cs);
   }
   if (req.has("status") && text(req.get("status"), "privacyStatus", "") != "") {
    cur = put(cur, "status", put(cur.get("status"), "privacyStatus", req.get("status").get("privacyStatus")));
   }
   db = put(db, "videos", put(videos, vid, cur));
   save(x, db);
   x.json(cur.to_json());
  }
 }
}

