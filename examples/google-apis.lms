# --- GA4 Data API Reports ---

fn row_dim_val(r: Json, dim: string) -> string {
 let v = "(not set)";
 if (dim == "country" || dim == "deviceCategory" || dim == "sessionDefaultChannelGroup" || dim == "date") {
  v = text(r, dim, "(not set)");
 }
 return v;
}

fn ga_metric_val_str(r: Json, m: string) -> string {
 let v = "0";
 if (m == "activeUsers" || m == "sessions" || m == "screenPageViews" || m == "conversions") {
  v = str(num(r, m, 0));
 } else if (m == "totalRevenue" && r.has("totalRevenue")) {
  v = str(r.get("totalRevenue").as_float());
 }
 return v;
}

@ga_property_action
fn ga_property_action(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let seg = x.param("id");
  let db = database(x);
  if (str_ends_with(seg, ":runReport")) {
   let req = json_parse(x.body());
   let reqDims = member(req, "dimensions");
   let reqMets = member(req, "metrics");
   let dimHeaders = json_parse("[]");
   let dimNames = json_parse("[]");
   if (reqDims.kind() == "array") {
    for (i in range(0, reqDims.len())) {
     let dn = text(reqDims.at(i), "name", "");
     dimNames = append(dimNames, json_parse(json_quote(dn)));
     dimHeaders = append(dimHeaders, json_parse("{\"name\":" + json_quote(dn) + "}"));
    }
   }
   let metHeaders = json_parse("[]");
   let metNames = json_parse("[]");
   if (reqMets.kind() == "array") {
    for (i in range(0, reqMets.len())) {
     let mn = text(reqMets.at(i), "name", "");
     metNames = append(metNames, json_parse(json_quote(mn)));
     let mt = "TYPE_INTEGER";
     if (mn == "totalRevenue") { mt = "TYPE_CURRENCY"; }
     metHeaders = append(metHeaders, json_parse("{\"name\":" + json_quote(mn) + ",\"type\":" + json_quote(mt) + "}"));
    }
   }
   let fField = "";
   let fVal = "";
   if (req.has("dimensionFilter") && req.get("dimensionFilter").has("filter")) {
    let f = req.get("dimensionFilter").get("filter");
    fField = text(f, "fieldName", "");
    if (f.has("stringFilter")) { fVal = text(f.get("stringFilter"), "value", ""); }
   }
   let limit = num(req, "limit", 100);
   if (limit <= 0) { limit = 100; }
   let rawRows = db.get("gaRows");
   let rowsOut = json_parse("[]");
   for (i in range(0, rawRows.len())) {
    if (rowsOut.len() < limit) {
     let r = rawRows.at(i);
     let keep = true;
     if (fField != "" && row_dim_val(r, fField) != fVal) { keep = false; }
     if (keep) {
      let dvals = json_parse("[]");
      for (di in range(0, dimNames.len())) {
       dvals = append(dvals, json_parse("{\"value\":" + json_quote(row_dim_val(r, dimNames.at(di).as_string())) + "}"));
      }
      let mvals = json_parse("[]");
      for (mi in range(0, metNames.len())) {
       mvals = append(mvals, json_parse("{\"value\":" + json_quote(ga_metric_val_str(r, metNames.at(mi).as_string())) + "}"));
      }
      rowsOut = append(rowsOut, json_parse("{\"dimensionValues\":" + dvals.to_json() + ",\"metricValues\":" + mvals.to_json() + "}"));
     }
    }
   }
   x.json("{\"dimensionHeaders\":" + dimHeaders.to_json() + ",\"metricHeaders\":" + metHeaders.to_json() + ",\"rows\":" + rowsOut.to_json() + ",\"rowCount\":" + str(rowsOut.len()) + "}");
  } else if (str_ends_with(seg, ":runRealtimeReport")) {
   let req = json_parse(x.body());
   let reqDims = member(req, "dimensions");
   let reqMets = member(req, "metrics");
   let dimHeaders = json_parse("[]");
   let dimNames = json_parse("[]");
   if (reqDims.kind() == "array") {
    for (i in range(0, reqDims.len())) {
     let dn = text(reqDims.at(i), "name", "");
     dimNames = append(dimNames, json_parse(json_quote(dn)));
     dimHeaders = append(dimHeaders, json_parse("{\"name\":" + json_quote(dn) + "}"));
    }
   }
   let metHeaders = json_parse("[]");
   let metNames = json_parse("[]");
   if (reqMets.kind() == "array") {
    for (i in range(0, reqMets.len())) {
     let mn = text(reqMets.at(i), "name", "");
     metNames = append(metNames, json_parse(json_quote(mn)));
     metHeaders = append(metHeaders, json_parse("{\"name\":" + json_quote(mn) + ",\"type\":\"TYPE_INTEGER\"}"));
    }
   }
   let limit = num(req, "limit", 100);
   if (limit <= 0) { limit = 100; }
   let rtRows = db.get("gaRealtimeRows");
   let rowsOut = json_parse("[]");
   for (i in range(0, rtRows.len())) {
    if (rowsOut.len() < limit) {
     let r = rtRows.at(i);
     let dvals = json_parse("[]");
     for (di in range(0, dimNames.len())) {
      dvals = append(dvals, json_parse("{\"value\":" + json_quote(row_dim_val(r, dimNames.at(di).as_string())) + "}"));
     }
     let mvals = json_parse("[]");
     for (mi in range(0, metNames.len())) {
      mvals = append(mvals, json_parse("{\"value\":" + json_quote(ga_metric_val_str(r, metNames.at(mi).as_string())) + "}"));
     }
     rowsOut = append(rowsOut, json_parse("{\"dimensionValues\":" + dvals.to_json() + ",\"metricValues\":" + mvals.to_json() + "}"));
    }
   }
   x.json("{\"dimensionHeaders\":" + dimHeaders.to_json() + ",\"metricHeaders\":" + metHeaders.to_json() + ",\"rows\":" + rowsOut.to_json() + ",\"rowCount\":" + str(rowsOut.len()) + "}");
  } else {
   api_error(x, 404, "notFound", "unknown property action: " + seg);
  }
 }
}

# --- YouTube Data API v3 Handlers ---

@yt_channels
fn yt_channels(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let db = database(x);
  let channels = db.get("channels");
  let items = json_parse("[]");
  let cid = x.query("id");
  if (x.query("mine") == "true") {
   items = append(items, channels.get("UC_ACME_DEV"));
  } else if (cid != "") {
   let parts = str_split(cid, ",");
   for (i in range(0, parts.len())) {
    let one = str_trim(parts.at(i));
    if (channels.has(one)) { items = append(items, channels.get(one)); }
   }
  } else {
   items = append(items, channels.get("UC_ACME_DEV"));
  }
  x.json("{\"kind\":\"youtube#channelListResponse\",\"items\":" + items.to_json() + "}");
 }
}

@yt_search
fn yt_search(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let db = database(x);
  let videos = db.get("videos");
  let order = db.get("videoOrder");
  let q = str_lower(str_trim(x.query("q")));
  let channelFilter = x.query("channelId");
  let maxRes = 25;
  if (str_is_int(x.query("maxResults"))) { maxRes = str_to_int(x.query("maxResults")); }
  if (maxRes <= 0) { maxRes = 25; }
  let items = json_parse("[]");
  for (i in range(0, order.len())) {
   if (items.len() < maxRes) {
    let vk = order.at(i).as_string();
    if (videos.has(vk)) {
     let v = videos.get(vk);
     if (!is_deleted(v)) {
      let snip = v.get("snippet");
      let chOk = channelFilter == "" || text(snip, "channelId", "") == channelFilter;
      let qOk = q == "" || str_contains(str_lower(text(snip, "title", "")), q) || str_contains(str_lower(text(snip, "description", "")), q);
      if (chOk && qOk) {
       items = append(items, json_parse("{\"kind\":\"youtube#searchResult\",\"id\":{\"kind\":\"youtube#video\",\"videoId\":" + json_quote(text(v, "id", vk)) + "},\"snippet\":" + snip.to_json() + "}"));
      }
     }
    }
   }
  }
  x.json("{\"kind\":\"youtube#searchListResponse\",\"items\":" + items.to_json() + "}");
 }
}

@yt_get_videos
