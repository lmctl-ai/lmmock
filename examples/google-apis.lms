@gmail_list_messages
fn gmail_list_messages(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let db = database(x);
  let msgs = db.get("gmailMessages");
  let order = db.get("gmailOrder");
  let q = x.query("q");
  let maxRes = 25;
  if (str_is_int(x.query("maxResults"))) { maxRes = str_to_int(x.query("maxResults")); }
  if (maxRes <= 0) { maxRes = 25; }
  let items = json_parse("[]");
  for (i in range(0, order.len())) {
   if (items.len() < maxRes) {
    let id = order.at(i).as_string();
    if (msgs.has(id)) {
     let m = msgs.get(id);
     if (!is_deleted(m) && gmail_matches_query(m, q)) {
      items = append(items, json_parse("{\"id\":" + json_quote(text(m, "id", id)) + ",\"threadId\":" + json_quote(text(m, "threadId", "")) + "}"));
     }
    }
   }
  }
  x.json("{\"messages\":" + items.to_json() + ",\"resultSizeEstimate\":" + str(items.len()) + "}");
 }
}

