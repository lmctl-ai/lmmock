@ga_list_properties
fn ga_list_properties(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let db = database(x);
  let filterParent = "";
  let f = str_trim(x.query("filter"));
  if (str_starts_with(f, "parent:")) { filterParent = str_trim(str_substr(f, 7, str_len(f) - 7)); }
  let props = db.get("properties");
  let order = db.get("propertyOrder");
  let out = json_parse("[]");
  for (i in range(0, order.len())) {
   let pk = order.at(i).as_string();
   if (props.has(pk)) {
    let pr = props.get(pk);
    if (!is_deleted(pr) && (filterParent == "" || text(pr, "parent", "") == filterParent || text(pr, "account", "") == filterParent)) {
     out = append(out, pr);
    }
   }
  }
  x.json("{\"properties\":" + out.to_json() + "}");
 }
}

@ga_create_property
fn ga_create_property(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let req = json_parse(x.body());
  let disp = text(req, "displayName", "");
  if (disp == "") {
   api_error(x, 400, "invalidArgument", "displayName is required");
  } else {
   let parent = text(req, "parent", "accounts/1001");
   let tz = text(req, "timeZone", "UTC");
   let curr = text(req, "currencyCode", "USD");
   let ind = text(req, "industryCategory", "TECHNOLOGY");
   let idNum = 399000 + x.increment("ga_prop_seq");
   let name = "properties/" + str(idNum);
   let prop = json_parse("{\"name\":" + json_quote(name) + ",\"parent\":" + json_quote(parent) + ",\"account\":" + json_quote(parent) + ",\"displayName\":" + json_quote(disp) + ",\"propertyType\":\"PROPERTY_TYPE_ORDINARY\",\"timeZone\":" + json_quote(tz) + ",\"currencyCode\":" + json_quote(curr) + ",\"industryCategory\":" + json_quote(ind) + ",\"serviceLevel\":\"GOOGLE_ANALYTICS_STANDARD\",\"createTime\":\"2026-11-14T22:00:00Z\"}");
   let db = database(x);
   db = put(db, "properties", put(db.get("properties"), name, prop));
   db = put(db, "propertyOrder", append(db.get("propertyOrder"), json_parse(json_quote(name))));
   save(x, db);
   x.json(prop.to_json());
  }
 }
}

@ga_get_property
fn ga_get_property(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let pk = norm_prop(x.param("id"));
  let db = database(x);
  let props = db.get("properties");
  if (!props.has(pk) || is_deleted(props.get(pk))) { api_error(x, 404, "notFound", "property not found: " + pk); }
  else { x.json(props.get(pk).to_json()); }
 }
}

@ga_update_property
fn ga_update_property(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let pk = norm_prop(x.param("id"));
  let db = database(x);
  let props = db.get("properties");
  if (!props.has(pk) || is_deleted(props.get(pk))) {
   api_error(x, 404, "notFound", "property not found: " + pk);
  } else {
   let prop = props.get(pk);
   let req = json_parse(x.body());
   let mask = x.query("updateMask");
   if ((mask == "" || has_csv_part(mask, "displayName") || has_csv_part(mask, "display_name")) && text(req, "displayName", "") != "") {
    prop = put(prop, "displayName", req.get("displayName"));
   }
   if ((mask == "" || has_csv_part(mask, "timeZone") || has_csv_part(mask, "time_zone")) && text(req, "timeZone", "") != "") {
    prop = put(prop, "timeZone", req.get("timeZone"));
   }
   if ((mask == "" || has_csv_part(mask, "currencyCode") || has_csv_part(mask, "currency_code")) && text(req, "currencyCode", "") != "") {
    prop = put(prop, "currencyCode", req.get("currencyCode"));
   }
   db = put(db, "properties", put(props, pk, prop));
   save(x, db);
   x.json(prop.to_json());
  }
 }
}

