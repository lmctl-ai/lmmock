# Build text templates from native JSON objects. Placeholders stand for complete
# JSON tokens; handlers explicitly quote string tokens before rendering.
response_templates = {};
for (name in ["chat_response", "responses_response", "anthropic_message", "gemini_response"]) {
 text = json_stringify(responses[name]);
 for (path in ["response.model", "response.item", "response.reason"]) {
  text = replace(text, json_stringify("<" + path + ">"), "<" + path + ">");
 }
 response_templates[name] = text;
}

p = _lmcode_ schema="schema.json";
fn fixture(name: string) -> Json { return json_parse(${json_stringify(responses)}).get(name); }

fn response_template(name: string) -> string { return json_parse(${json_stringify(response_templates)}).get(name).as_string(); }

fn json_text(value: string) -> Json { return json_parse(json_quote(value)); }
fn with_text(document: Json, pointer: string, value: string) -> Json { return json_with(document,pointer,json_text(value)); }
fn render_response(name: string, model: string, item: Json, reason: string) -> string {
 let values = json_parse("{}");
 values = json_with(values,"/model",json_text(json_quote(model)));
 values = json_with(values,"/item",item);
 values = json_with(values,"/reason",json_text(json_quote(reason)));
 let context = json_with(json_parse("{}"),"/response",values);
 return json_parse(template_render(response_template(name),context)).to_json();
}

fn field(j: Json, key: string) -> string { let value = ""; if (j.has(key)) { value = j.get(key).as_string(); } return value; }
@chat
fn completion(x: Exchange) -> void implements Handler {
 while (true) {
  x.set("last",x.request_json());
  let c = json_parse(config()); let mode = field(c,"mode"); let auth = x.header("Authorization");
  if (mode == "unauthorized" || (c.has("apiKey") && !secure_equal(auth,"Bearer " + field(c,"apiKey")))) { x.status(401); x.json(json_with(fixture("chat_auth_error"),"/error/message",json_text("Invalid API key")).to_json()); break; }
  let retry = false; if (mode == "retry") { retry = x.increment("llm-retry") == 1; }
  if (mode == "rate-limit" || retry) { x.status(429); x.set_header("Retry-After","1"); x.json(fixture("chat_rate_limit").to_json()); break; }
  if (mode == "server-error") { x.status(503); x.json(fixture("chat_unavailable").to_json()); break; }
  if (mode == "disconnect") { x.disconnect(); break; }
  if (mode == "bad-json") { x.json("{broken"); break; }
  if (mode == "timeout") { x.delay(1000); }
  let request = json_parse(x.body()); let model = "mock-agent"; if (request.has("model")) { model = field(request,"model"); }
  if (mode == "unknown-model" || model == "unknown-model") { x.status(404); x.json(fixture("chat_model_missing").to_json()); break; }
  if (model == "overloaded") { x.status(429); x.set_header("Retry-After","1"); x.json(fixture("chat_overloaded").to_json()); break; }
  let content = "pong"; let reason = "stop"; let message = ""; let tool = false;
  let messages = request.get("messages"); let tool_result = false;
  for (i in range(0,messages.len())) { if (field(messages.at(i),"role") == "tool") { tool_result = true; content = "Tool result: " + field(messages.at(i),"content"); } }
  if (request.has("tools") && !tool_result) { tool = request.get("tools").len() > 0; }
  if (request.has("tool_choice")) { if (request.get("tool_choice").to_json() == json_quote("none")) { tool = false; } }
  if (c.has("text")) { content = field(c,"text"); }
  if (request.has("response_format")) { content = fixture("structured_city").to_json(); if (c.has("structuredOutput")) { content = c.get("structuredOutput").to_json(); } }
  if (mode == "ok" || mode == "echo" || mode == "timeout") { model = "served-model"; }
  if (c.has("responseModel")) { model = field(c,"responseModel"); }
  if (mode == "echo") { content = str_substr(auth,7,str_len(auth)); }
  let tools = fixture("empty_array").to_json();
  if (tool) {
   let name = field(request.get("tools").at(0).get("function"),"name");
   tools = json_with(fixture("chat_tool_calls"),"/0/function/name",json_text(name)).to_json();
   reason = "tool_calls"; message = json_with(fixture("chat_tool_message"),"/tool_calls",json_parse(tools)).to_json();
  } else { message = json_with(fixture("chat_text_message"),"/content",json_text(content)).to_json(); }
  let stream = false; if (request.has("stream")) { stream = request.get("stream").as_bool(); }
  if (stream) {
   x.set_header("Content-Type","text/event-stream");
   let delta = json_with(fixture("chat_text_delta"),"/content",json_text(content)).to_json();
   if (tool) { let name = field(request.get("tools").at(0).get("function"),"name"); delta = json_with(fixture("chat_tool_delta"),"/tool_calls/0/function/name",json_text(name)).to_json(); }
   let chunk = with_text(fixture("chat_chunk"),"/model",model);
   chunk = json_with(chunk,"/choices/0/delta",json_parse(delta));
   let finish = with_text(fixture("chat_finish"),"/choices/0/finish_reason",reason);
   let usage = with_text(fixture("chat_usage"),"/model",model);
   x.send("data: " + chunk.to_json() + "\n\ndata: " + finish.to_json() + "\n\ndata: " + usage.to_json() + "\n\ndata: [DONE]\n\n");
  } else { x.json(render_response("chat_response",model,json_parse(message),reason)); }
  break;
 }
}
@inspect
fn inspect(x: Exchange) -> void implements Handler { let last = x.get("last"); if (last == "") { last = fixture("empty_object").to_json(); } x.json(last); }
route("POST","/chat/completions","chat");
route("POST","/api/v1/chat/completions","chat");
route("POST","/v1/chat/completions","chat");route("GET","/__inspect","inspect");


# Shared policy for models, embeddings and Responses.
fn api_allowed(x: Exchange) -> bool {
 let c = json_parse(config()); let ok = true;
 if (c.has("apiKey")) {
  ok = secure_equal(x.header("Authorization"), "Bearer " + field(c,"apiKey"));
 }
 let mode = field(c,"mode");
 if (!ok || mode == "unauthorized") { ok = false; x.status(401); x.json(fixture("api_auth_error").to_json()); }
 else if (mode == "rate-limit") { ok = false; x.status(429); x.set_header("Retry-After","1"); x.json(fixture("api_rate_limit").to_json()); }
 else if (mode == "server-error") { ok = false; x.status(503); x.json(fixture("api_unavailable").to_json()); }
 else if (mode == "disconnect") { ok = false; x.disconnect(); }
 else if (mode == "bad-json") { ok = false; x.json("{broken"); }
 else if (mode == "timeout") { x.delay(1000); }
 return ok;
}
@models
fn models(x: Exchange) -> void implements Handler {
 if (api_allowed(x)) { x.json(fixture("models").to_json()); }
}
@embeddings
fn embeddings(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (api_allowed(x)) {
  let b = json_parse(x.body()); let count = 1;
  if (str_starts_with(b.get("input").to_json(),"[")) { count = b.get("input").len(); }
  let data = fixture("empty_array");
  for (i in range(0,count)) {
   let row = json_with(fixture("embedding_row"),"/index",json_parse(str(i)));
   data = json_with(data,"/-",row);
  }
  let result = with_text(fixture("embeddings"),"/model",field(b,"model"));
  x.json(json_with(result,"/data",data).to_json());
 }
}
fn event(kind: string, body: string) -> string { return "event: " + kind + "\ndata: " + body + "\n\n"; }
@responses
fn responses(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (api_allowed(x)) {
  let b = json_parse(x.body()); let c = json_parse(config());
  let model = field(b,"model"); let content = "pong";
  if (c.has("text")) { content = field(c,"text"); }
  let tool_result = false;
  if (b.has("input")) {
   if (str_starts_with(b.get("input").to_json(),"[")) {
    let input = b.get("input");
    for (i in range(0,input.len())) {
     if (field(input.at(i),"type") == "function_call_output") {
      tool_result = true; content = "Tool result: " + field(input.at(i),"output");
     }
    }
   }
  }
  let tool = false;
  if (b.has("tools") && !tool_result) { tool = b.get("tools").len() > 0; }
  if (b.has("tool_choice")) { if (b.get("tool_choice").to_json() == json_quote("none")) { tool = false; } }
  if (b.has("text")) {
   if (b.get("text").has("format")) {
    content = fixture("responses_structured").to_json();
    if (c.has("structuredOutput")) { content = c.get("structuredOutput").to_json(); }
   }
  }
  let item = json_with(fixture("responses_message"),"/content/0/text",json_text(content)).to_json();
  if (tool) {
   item = json_with(fixture("responses_tool"),"/name",json_text(field(b.get("tools").at(0),"name"))).to_json();
  }
  let response = render_response("responses_response",model,json_parse(item),"");
  let stream = false; if (b.has("stream")) { stream = b.get("stream").as_bool(); }
  if (!stream) { x.json(response); }
  else {
   x.set_header("Content-Type","text/event-stream");
   let events = event("response.created",json_with(fixture("response_created"),"/response/model",json_text(model)).to_json());
   events = events + event("response.output_item.added",json_with(fixture("response_output_item_added"),"/item",json_parse(item)).to_json());
   if (!tool) {
    events = events + event("response.content_part.added",fixture("response_content_part_added").to_json());
    events = events + event("response.output_text.delta",json_with(fixture("response_output_text_delta"),"/delta",json_text(content)).to_json());
    events = events + event("response.output_text.done",json_with(fixture("response_output_text_done"),"/text",json_text(content)).to_json());
   }
   events = events + event("response.output_item.done",json_with(fixture("response_output_item_done"),"/item",json_parse(item)).to_json());
   events = events + event("response.completed",json_with(fixture("response_completed"),"/response",json_parse(response)).to_json());
   x.send(events);
  }
 }
}
route("GET","/v1/models","models");route("GET","/models","models");
route("POST","/v1/embeddings","embeddings");route("POST","/embeddings","embeddings");
route("POST","/v1/responses","responses");route("POST","/responses","responses");


# Native provider policies preserve their credential and error envelopes.
fn native_error(x: Exchange, provider: string, status: int, kind: string, message: string) -> void {
 x.status(status);
 if (provider == "anthropic") {
  x.json(json_with(json_with(fixture("anthropic_error"),"/error/type",json_text(kind)),"/error/message",json_text(message)).to_json());
 } else {
  x.json(json_with(json_with(json_with(fixture("gemini_error"),"/error/code",json_parse(str(status))),"/error/status",json_text(kind)),"/error/message",json_text(message)).to_json());
 }
}
fn native_allowed(x: Exchange, provider: string) -> bool {
 let c = json_parse(config()); let mode = field(c,"mode"); let ok = true;
 let credential = x.header("x-api-key");
 if (provider == "gemini") {
  credential = x.header("x-goog-api-key");
  if (credential == "") { credential = x.query("key"); }
 }
 if (c.has("apiKey")) { ok = secure_equal(credential,field(c,"apiKey")); }
 if (!ok || mode == "unauthorized") {
  ok = false;
  if (provider == "anthropic") { native_error(x,provider,401,"authentication_error","Invalid API key"); }
  else { native_error(x,provider,403,"PERMISSION_DENIED","Invalid API key"); }
 } else if (provider == "anthropic" && x.header("anthropic-version") == "") {
  ok = false; native_error(x,provider,400,"invalid_request_error","anthropic-version is required");
 } else if (mode == "rate-limit") {
  ok = false; x.set_header("Retry-After","1");
  if (provider == "anthropic") { native_error(x,provider,429,"rate_limit_error","Rate limited"); }
  else { native_error(x,provider,429,"RESOURCE_EXHAUSTED","Rate limited"); }
 } else if (mode == "server-error") {
  ok = false;
  if (provider == "anthropic") { native_error(x,provider,529,"overloaded_error","Overloaded"); }
  else { native_error(x,provider,503,"UNAVAILABLE","Unavailable"); }
 } else if (mode == "bad-json") { ok = false; x.json("{broken"); }
 else if (mode == "disconnect") { ok = false; x.disconnect(); }
 else if (mode == "timeout") { x.delay(1000); }
 return ok;
}
@anthropic_messages
fn anthropic_messages(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (native_allowed(x,"anthropic")) {
  let b = json_parse(x.body()); let c = json_parse(config()); let text = "pong";
  if (c.has("text")) { text = field(c,"text"); }
  let tool_result = false;
  let messages = b.get("messages");
  for (i in range(0,messages.len())) {
   let blocks = messages.at(i).get("content");
   if (str_starts_with(blocks.to_json(),"[")) {
    for (j in range(0,blocks.len())) {
     if (field(blocks.at(j),"type") == "tool_result") {
      tool_result = true; text = "Tool result: " + blocks.at(j).get("content").to_json();
     }
    }
   }
  }
  let tool = false;
  if (b.has("tools") && !tool_result) { tool = b.get("tools").len() > 0; }
  if (b.has("tool_choice")) { if (field(b.get("tool_choice"),"type") == "none") { tool = false; } }
  if (b.has("output_config")) {
   if (b.get("output_config").has("format")) {
    text = fixture("anthropic_structured").to_json();
    if (c.has("structuredOutput")) { text = c.get("structuredOutput").to_json(); }
   }
  }
  let reason = "end_turn";
  let block = json_with(fixture("anthropic_text"),"/text",json_text(text)).to_json();
  let start_block = fixture("anthropic_text_start").to_json();
  let delta = json_with(fixture("anthropic_text_delta"),"/text",json_text(text)).to_json();
  if (tool) {
   reason = "tool_use";
   let name = field(b.get("tools").at(0),"name");
   block = json_with(fixture("anthropic_tool"),"/name",json_text(name)).to_json();
   start_block = json_with(fixture("anthropic_tool_start"),"/name",json_text(name)).to_json();
   delta = fixture("anthropic_tool_delta").to_json();
  }
  let response = render_response("anthropic_message",field(b,"model"),json_parse(block),reason);
  let stream = false; if (b.has("stream")) { stream = b.get("stream").as_bool(); }
  if (!stream) { x.json(response); }
  else {
   x.set_header("Content-Type","text/event-stream");
   let start = with_text(fixture("anthropic_start"),"/message/model",field(b,"model"));
   let events = event("message_start",start.to_json());
   events = events + event("content_block_start",json_with(fixture("content_block_start"),"/content_block",json_parse(start_block)).to_json());
   events = events + event("content_block_delta",json_with(fixture("content_block_delta"),"/delta",json_parse(delta)).to_json());
   events = events + event("content_block_stop",fixture("content_block_stop").to_json());
   events = events + event("message_delta",json_with(fixture("message_delta"),"/delta/stop_reason",json_text(reason)).to_json());
   events = events + event("message_stop",fixture("message_stop").to_json());
   x.send(events);
  }
 }
}
@gemini_content
fn gemini_content(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (native_allowed(x,"gemini")) {
  let operation = x.param("operation");
  if (str_ends_with(operation,":embedContent")) {
   x.json(fixture("gemini_embedding").to_json());
  } else if (str_ends_with(operation,":batchEmbedContents")) {
   let b = json_parse(x.body()); let rows = fixture("empty_array");
   let requests = b.get("requests");
   for (i in range(0,requests.len())) { rows = json_with(rows,"/-",fixture("gemini_vector")); }
   x.json(json_with(fixture("gemini_embeddings"),"/embeddings",rows).to_json());
  } else if (!str_ends_with(operation,":generateContent") && !str_ends_with(operation,":streamGenerateContent")) {
   native_error(x,"gemini",404,"NOT_FOUND","Unsupported model operation");
  } else {
   let b = json_parse(x.body()); let c = json_parse(config()); let text = "pong";
   if (c.has("text")) { text = field(c,"text"); }
   let tool_result = false; let contents = b.get("contents");
   for (i in range(0,contents.len())) {
    let parts = contents.at(i).get("parts");
    for (j in range(0,parts.len())) {
     if (parts.at(j).has("functionResponse")) {
      tool_result = true; text = "Tool result: " + parts.at(j).get("functionResponse").get("response").to_json();
     }
    }
   }
   let tool_name = "";
   if (b.has("tools") && !tool_result) {
    let tools = b.get("tools");
    for (i in range(0,tools.len())) {
     if (tools.at(i).has("functionDeclarations")) {
      let declarations = tools.at(i).get("functionDeclarations");
      if (declarations.len() > 0 && tool_name == "") { tool_name = field(declarations.at(0),"name"); }
     }
    }
   }
   if (b.has("toolConfig")) {
    if (b.get("toolConfig").has("functionCallingConfig")) {
     if (field(b.get("toolConfig").get("functionCallingConfig"),"mode") == "NONE") { tool_name = ""; }
    }
   }
   if (b.has("generationConfig")) {
    if (field(b.get("generationConfig"),"responseMimeType") == "application/json") {
     text = fixture("gemini_structured").to_json();
     if (c.has("structuredOutput")) { text = c.get("structuredOutput").to_json(); }
    }
   }
   let part = json_with(fixture("gemini_text"),"/text",json_text(text)).to_json();
   if (tool_name != "") { part = json_with(fixture("gemini_function"),"/functionCall/name",json_text(tool_name)).to_json(); }
   let response = render_response("gemini_response","",json_parse(part),"");
   if (str_ends_with(operation,":streamGenerateContent")) {
    x.set_header("Content-Type","text/event-stream"); x.send("data: " + response + "\n\n");
   } else { x.json(response); }
  }
 }
}
route("POST","/v1/messages","anthropic_messages");
route("POST","/v1beta/models/{operation}","gemini_content");
end _lmcode_
savedsl(p,ARGV[0]);
