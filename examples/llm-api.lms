# Standalone deterministic mock LLM API. See docs/llm-api.md.
p = _lmcode_ schema="schema.json";
fn field(j: Json, key: string) -> string { let value = ""; if (j.has(key)) { value = j.get(key).as_string(); } return value; }
@chat
fn completion(x: Exchange) -> void implements Handler {
 while (true) {
  x.set("last",x.request_json());
  let c = json_parse(config()); let mode = field(c,"mode"); let auth = x.header("Authorization");
  if (mode == "unauthorized" || (c.has("apiKey") && !secure_equal(auth,"Bearer " + field(c,"apiKey")))) { x.status(401); x.json("{\"error\":{\"message\":" + json_quote("Invalid API key") + ",\"type\":\"authentication_error\"}}"); break; }
  let retry = false; if (mode == "retry") { retry = x.increment("llm-retry") == 1; }
  if (mode == "rate-limit" || retry) { x.status(429); x.set_header("Retry-After","1"); x.json("{\"error\":{\"message\":\"rate limited\",\"type\":\"rate_limit_error\"}}"); break; }
  if (mode == "server-error") { x.status(503); x.json("{\"error\":{\"message\":\"unavailable\"}}"); break; }
  if (mode == "disconnect") { x.disconnect(); break; }
  if (mode == "bad-json") { x.json("{broken"); break; }
  if (mode == "timeout") { x.delay(1000); }
  let request = json_parse(x.body()); let model = "mock-agent"; if (request.has("model")) { model = field(request,"model"); }
  if (mode == "unknown-model" || model == "unknown-model") { x.status(404); x.json("{\"error\":{\"message\":\"model not found\",\"type\":\"invalid_request_error\",\"code\":\"model_not_found\"}}"); break; }
  if (model == "overloaded") { x.status(429); x.set_header("Retry-After","1"); x.json("{\"error\":{\"message\":\"rate limited\",\"type\":\"rate_limit_error\"}}"); break; }
  let content = "pong"; let reason = "stop"; let message = ""; let tool = false;
  let messages = request.get("messages"); let tool_result = false;
  for (i in range(0,messages.len())) { if (field(messages.at(i),"role") == "tool") { tool_result = true; content = "Tool result: " + field(messages.at(i),"content"); } }
  if (request.has("tools") && !tool_result) { tool = request.get("tools").len() > 0; }
  if (request.has("tool_choice")) { if (request.get("tool_choice").to_json() == json_quote("none")) { tool = false; } }
  if (c.has("text")) { content = field(c,"text"); }
  if (request.has("response_format")) { content = "{\"city\":\"Paris\"}"; if (c.has("structuredOutput")) { content = c.get("structuredOutput").to_json(); } }
  if (mode == "ok" || mode == "echo" || mode == "timeout") { model = "served-model"; }
  if (c.has("responseModel")) { model = field(c,"responseModel"); }
  if (mode == "echo") { content = str_substr(auth,7,str_len(auth)); }
  let tools = "[]";
  if (tool) {
   let name = field(request.get("tools").at(0).get("function"),"name");
   tools = "[{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":" + json_quote(name) + ",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\"}}]";
   reason = "tool_calls"; message = "{\"role\":\"assistant\",\"content\":null,\"tool_calls\":" + tools + "}";
  } else { message = "{\"role\":\"assistant\",\"content\":" + json_quote(content) + "}"; }
  let stream = false; if (request.has("stream")) { stream = request.get("stream").as_bool(); }
  if (stream) {
   x.set_header("Content-Type","text/event-stream");
   let delta = "{\"role\":\"assistant\",\"content\":" + json_quote(content) + "}";
   if (tool) { let name = field(request.get("tools").at(0).get("function"),"name"); delta = "{\"role\":\"assistant\",\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":" + json_quote(name) + ",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\"}}]}"; }
   x.send("data: {\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion.chunk\",\"model\":" + json_quote(model) + ",\"choices\":[{\"index\":0,\"delta\":" + delta + ",\"finish_reason\":null}]}\n\ndata: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":" + json_quote(reason) + "}]}\n\ndata: {\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion.chunk\",\"model\":\"mock-agent\",\"choices\":[],\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":2,\"total_tokens\":4}}\n\ndata: [DONE]\n\n");
  } else { x.json("{\"id\":\"chatcmpl-mock\",\"object\":\"chat.completion\",\"model\":" + json_quote(model) + ",\"choices\":[{\"index\":0,\"message\":" + message + ",\"finish_reason\":" + json_quote(reason) + "}],\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":2,\"total_tokens\":4}}"); }
  break;
 }
}
@inspect
fn inspect(x: Exchange) -> void implements Handler { let last = x.get("last"); if (last == "") { last = "{}"; } x.json(last); }
route("POST","/chat/completions","chat");
route("POST","/api/v1/chat/completions","chat");
route("POST","/v1/chat/completions","chat");route("GET","/__inspect","inspect");


# Shared policy for models, embeddings and Responses.
fn api_allowed(x: Exchange) -> bool {
 let c = json_parse(config()); let ok = true;
 if (c.has("apiKey")) {
  ok = secure_equal(x.header("Authorization"), "Bearer " + field(c,"apiKey"));
 }
 let mode = field(c,"mode");
 if (!ok || mode == "unauthorized") { ok = false; x.status(401); x.json("{\"error\":{\"message\":\"Invalid API key\",\"type\":\"authentication_error\",\"code\":\"invalid_api_key\"}}"); }
 else if (mode == "rate-limit") { ok = false; x.status(429); x.set_header("Retry-After","1"); x.json("{\"error\":{\"message\":\"rate limited\",\"type\":\"rate_limit_error\"}}"); }
 else if (mode == "server-error") { ok = false; x.status(503); x.json("{\"error\":{\"message\":\"unavailable\",\"type\":\"server_error\"}}"); }
 else if (mode == "disconnect") { ok = false; x.disconnect(); }
 else if (mode == "bad-json") { ok = false; x.json("{broken"); }
 else if (mode == "timeout") { x.delay(1000); }
 return ok;
}
@models
fn models(x: Exchange) -> void implements Handler {
 if (api_allowed(x)) { x.json("{\"object\":\"list\",\"data\":[{\"id\":\"mock-agent\",\"object\":\"model\",\"created\":1700000000,\"owned_by\":\"lmmock\"},{\"id\":\"mock-embedding\",\"object\":\"model\",\"created\":1700000000,\"owned_by\":\"lmmock\"}]}"); }
}
@embeddings
fn embeddings(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (api_allowed(x)) {
  let b = json_parse(x.body()); let count = 1;
  if (str_starts_with(b.get("input").to_json(),"[")) { count = b.get("input").len(); }
  let data = "";
  for (i in range(0,count)) {
   if (i > 0) { data = data + ","; }
   data = data + "{\"object\":\"embedding\",\"index\":" + str(i) + ",\"embedding\":[0.1,0.2,0.3]}";
  }
  x.json("{\"object\":\"list\",\"model\":" + json_quote(field(b,"model")) + ",\"data\":[" + data + "],\"usage\":{\"prompt_tokens\":2,\"total_tokens\":2}}");
 }
}
fn event(kind: string, body: string) -> string { return "event: " + kind + "\ndata: " + body + "\n\n"; }
@responses
fn responses(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (api_allowed(x)) {
  let b = json_parse(x.body()); let c = json_parse(config());
  let model = field(b,"model"); let content = "pong";
  if (c.has("text")) { content = field(c,"text"); }
  let tool_result = false;
  if (b.has("input")) {
   if (str_starts_with(b.get("input").to_json(),"[")) {
    let input = b.get("input");
    for (i in range(0,input.len())) {
     if (field(input.at(i),"type") == "function_call_output") {
      tool_result = true; content = "Tool result: " + field(input.at(i),"output");
     }
    }
   }
  }
  let tool = false;
  if (b.has("tools") && !tool_result) { tool = b.get("tools").len() > 0; }
  if (b.has("tool_choice")) { if (b.get("tool_choice").to_json() == json_quote("none")) { tool = false; } }
  if (b.has("text")) {
   if (b.get("text").has("format")) {
    content = "{\"city\":\"Paris\"}";
    if (c.has("structuredOutput")) { content = c.get("structuredOutput").to_json(); }
   }
  }
  let item = "{\"type\":\"message\",\"id\":\"msg_mock\",\"status\":\"completed\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":" + json_quote(content) + ",\"annotations\":[]}]}";
  if (tool) {
   item = "{\"type\":\"function_call\",\"id\":\"fc_mock\",\"call_id\":\"call_1\",\"status\":\"completed\",\"name\":" + json_quote(field(b.get("tools").at(0),"name")) + ",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\"}";
  }
  let response = "{\"id\":\"resp_mock\",\"object\":\"response\",\"created_at\":1700000000,\"status\":\"completed\",\"model\":" + json_quote(model) + ",\"output\":[" + item + "],\"usage\":{\"input_tokens\":2,\"output_tokens\":2,\"total_tokens\":4}}";
  let stream = false; if (b.has("stream")) { stream = b.get("stream").as_bool(); }
  if (!stream) { x.json(response); }
  else {
   x.set_header("Content-Type","text/event-stream");
   let events = event("response.created","{\"type\":\"response.created\",\"response\":{\"id\":\"resp_mock\",\"created_at\":1700000000,\"model\":" + json_quote(model) + "}}");
   events = events + event("response.output_item.added","{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":" + item + "}");
   if (!tool) {
    events = events + event("response.content_part.added","{\"type\":\"response.content_part.added\",\"item_id\":\"msg_mock\",\"output_index\":0,\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":\"\",\"annotations\":[]}}");
    events = events + event("response.output_text.delta","{\"type\":\"response.output_text.delta\",\"item_id\":\"msg_mock\",\"output_index\":0,\"content_index\":0,\"delta\":" + json_quote(content) + "}");
    events = events + event("response.output_text.done","{\"type\":\"response.output_text.done\",\"item_id\":\"msg_mock\",\"output_index\":0,\"content_index\":0,\"text\":" + json_quote(content) + "}");
   }
   events = events + event("response.output_item.done","{\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":" + item + "}");
   events = events + event("response.completed","{\"type\":\"response.completed\",\"response\":" + response + "}");
   x.send(events);
  }
 }
}
route("GET","/v1/models","models");route("GET","/models","models");
route("POST","/v1/embeddings","embeddings");route("POST","/embeddings","embeddings");
route("POST","/v1/responses","responses");route("POST","/responses","responses");


# Native provider policies preserve their credential and error envelopes.
fn native_error(x: Exchange, provider: string, status: int, kind: string, message: string) -> void {
 x.status(status);
 if (provider == "anthropic") {
  x.json("{\"type\":\"error\",\"error\":{\"type\":" + json_quote(kind) + ",\"message\":" + json_quote(message) + "}}");
 } else {
  x.json("{\"error\":{\"code\":" + str(status) + ",\"status\":" + json_quote(kind) + ",\"message\":" + json_quote(message) + "}}");
 }
}
fn native_allowed(x: Exchange, provider: string) -> bool {
 let c = json_parse(config()); let mode = field(c,"mode"); let ok = true;
 let credential = x.header("x-api-key");
 if (provider == "gemini") {
  credential = x.header("x-goog-api-key");
  if (credential == "") { credential = x.query("key"); }
 }
 if (c.has("apiKey")) { ok = secure_equal(credential,field(c,"apiKey")); }
 if (!ok || mode == "unauthorized") {
  ok = false;
  if (provider == "anthropic") { native_error(x,provider,401,"authentication_error","Invalid API key"); }
  else { native_error(x,provider,403,"PERMISSION_DENIED","Invalid API key"); }
 } else if (provider == "anthropic" && x.header("anthropic-version") == "") {
  ok = false; native_error(x,provider,400,"invalid_request_error","anthropic-version is required");
 } else if (mode == "rate-limit") {
  ok = false; x.set_header("Retry-After","1");
  if (provider == "anthropic") { native_error(x,provider,429,"rate_limit_error","Rate limited"); }
  else { native_error(x,provider,429,"RESOURCE_EXHAUSTED","Rate limited"); }
 } else if (mode == "server-error") {
  ok = false;
  if (provider == "anthropic") { native_error(x,provider,529,"overloaded_error","Overloaded"); }
  else { native_error(x,provider,503,"UNAVAILABLE","Unavailable"); }
 } else if (mode == "bad-json") { ok = false; x.json("{broken"); }
 else if (mode == "disconnect") { ok = false; x.disconnect(); }
 else if (mode == "timeout") { x.delay(1000); }
 return ok;
}
@anthropic_messages
fn anthropic_messages(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (native_allowed(x,"anthropic")) {
  let b = json_parse(x.body()); let c = json_parse(config()); let text = "pong";
  if (c.has("text")) { text = field(c,"text"); }
  let tool_result = false;
  let messages = b.get("messages");
  for (i in range(0,messages.len())) {
   let blocks = messages.at(i).get("content");
   if (str_starts_with(blocks.to_json(),"[")) {
    for (j in range(0,blocks.len())) {
     if (field(blocks.at(j),"type") == "tool_result") {
      tool_result = true; text = "Tool result: " + blocks.at(j).get("content").to_json();
     }
    }
   }
  }
  let tool = false;
  if (b.has("tools") && !tool_result) { tool = b.get("tools").len() > 0; }
  if (b.has("tool_choice")) { if (field(b.get("tool_choice"),"type") == "none") { tool = false; } }
  if (b.has("output_config")) {
   if (b.get("output_config").has("format")) {
    text = "{\"city\":\"Paris\"}";
    if (c.has("structuredOutput")) { text = c.get("structuredOutput").to_json(); }
   }
  }
  let reason = "end_turn";
  let block = "{\"type\":\"text\",\"text\":" + json_quote(text) + "}";
  let start_block = "{\"type\":\"text\",\"text\":\"\"}";
  let delta = "{\"type\":\"text_delta\",\"text\":" + json_quote(text) + "}";
  if (tool) {
   reason = "tool_use";
   let name = field(b.get("tools").at(0),"name");
   block = "{\"type\":\"tool_use\",\"id\":\"call_1\",\"name\":" + json_quote(name) + ",\"input\":{\"city\":\"Paris\"}}";
   start_block = "{\"type\":\"tool_use\",\"id\":\"call_1\",\"name\":" + json_quote(name) + ",\"input\":{}}";
   delta = "{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"city\\\":\\\"Paris\\\"}\"}";
  }
  let prefix = "{\"id\":\"msg_mock\",\"type\":\"message\",\"role\":\"assistant\",\"model\":" + json_quote(field(b,"model"));
  let response = prefix + ",\"content\":[" + block + "],\"stop_reason\":" + json_quote(reason) + ",\"stop_sequence\":null,\"usage\":{\"input_tokens\":2,\"output_tokens\":2}}";
  let stream = false; if (b.has("stream")) { stream = b.get("stream").as_bool(); }
  if (!stream) { x.json(response); }
  else {
   x.set_header("Content-Type","text/event-stream");
   let events = event("message_start","{\"type\":\"message_start\",\"message\":" + prefix + ",\"content\":[],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":2,\"output_tokens\":0}}}");
   events = events + event("content_block_start","{\"type\":\"content_block_start\",\"index\":0,\"content_block\":" + start_block + "}");
   events = events + event("content_block_delta","{\"type\":\"content_block_delta\",\"index\":0,\"delta\":" + delta + "}");
   events = events + event("content_block_stop","{\"type\":\"content_block_stop\",\"index\":0}");
   events = events + event("message_delta","{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":" + json_quote(reason) + ",\"stop_sequence\":null},\"usage\":{\"output_tokens\":2}}");
   events = events + event("message_stop","{\"type\":\"message_stop\"}");
   x.send(events);
  }
 }
}
@gemini_content
fn gemini_content(x: Exchange) -> void implements Handler {
 x.set("last",x.request_json());
 if (native_allowed(x,"gemini")) {
  let operation = x.param("operation");
  if (str_ends_with(operation,":embedContent")) {
   x.json("{\"embedding\":{\"values\":[0.1,0.2,0.3]}}");
  } else if (str_ends_with(operation,":batchEmbedContents")) {
   let b = json_parse(x.body()); let rows = "";
   let requests = b.get("requests");
   for (i in range(0,requests.len())) {
    if (i > 0) { rows = rows + ","; }
    rows = rows + "{\"values\":[0.1,0.2,0.3]}";
   }
   x.json("{\"embeddings\":[" + rows + "]}");
  } else if (!str_ends_with(operation,":generateContent") && !str_ends_with(operation,":streamGenerateContent")) {
   native_error(x,"gemini",404,"NOT_FOUND","Unsupported model operation");
  } else {
   let b = json_parse(x.body()); let c = json_parse(config()); let text = "pong";
   if (c.has("text")) { text = field(c,"text"); }
   let tool_result = false; let contents = b.get("contents");
   for (i in range(0,contents.len())) {
    let parts = contents.at(i).get("parts");
    for (j in range(0,parts.len())) {
     if (parts.at(j).has("functionResponse")) {
      tool_result = true; text = "Tool result: " + parts.at(j).get("functionResponse").get("response").to_json();
     }
    }
   }
   let tool_name = "";
   if (b.has("tools") && !tool_result) {
    let tools = b.get("tools");
    for (i in range(0,tools.len())) {
     if (tools.at(i).has("functionDeclarations")) {
      let declarations = tools.at(i).get("functionDeclarations");
      if (declarations.len() > 0 && tool_name == "") { tool_name = field(declarations.at(0),"name"); }
     }
    }
   }
   if (b.has("toolConfig")) {
    if (b.get("toolConfig").has("functionCallingConfig")) {
     if (field(b.get("toolConfig").get("functionCallingConfig"),"mode") == "NONE") { tool_name = ""; }
    }
   }
   if (b.has("generationConfig")) {
    if (field(b.get("generationConfig"),"responseMimeType") == "application/json") {
     text = "{\"city\":\"Paris\"}";
     if (c.has("structuredOutput")) { text = c.get("structuredOutput").to_json(); }
    }
   }
   let part = "{\"text\":" + json_quote(text) + "}";
   if (tool_name != "") { part = "{\"functionCall\":{\"name\":" + json_quote(tool_name) + ",\"args\":{\"city\":\"Paris\"}}}"; }
   let response = "{\"candidates\":[{\"index\":0,\"content\":{\"role\":\"model\",\"parts\":[" + part + "]},\"finishReason\":\"STOP\"}],\"usageMetadata\":{\"promptTokenCount\":2,\"candidatesTokenCount\":2,\"totalTokenCount\":4},\"modelVersion\":\"mock-gemini\"}";
   if (str_ends_with(operation,":streamGenerateContent")) {
    x.set_header("Content-Type","text/event-stream"); x.send("data: " + response + "\n\n");
   } else { x.json(response); }
  }
 }
}
route("POST","/v1/messages","anthropic_messages");
route("POST","/v1beta/models/{operation}","gemini_content");
end _lmcode_
savedsl(p,ARGV[0]);
