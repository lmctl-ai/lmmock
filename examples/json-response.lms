# Ordinary runtime lmscript data: a template and a nested context map.
template = {
  message: "<request.text>",
  metadata: "<metadata>",
  items: "<request.items>"
};
context = {
  request: {text: env("LMMOCK_GREETING") || "hello", items: []},
  metadata: {provider: "lmmock", enabled: true}
};

# Remove placeholder quotes from the serialized template: each is a JSON token.
template_text = json_stringify(template);
for (path in ["request.text", "metadata", "request.items"]) {
 template_text = replace(template_text, json_stringify("<" + path + ">"), "<" + path + ">");
}

p = _lmcode_ schema="schema.json";
@message
fn message(x: Exchange) -> void implements Handler {
 let template = ${template_text};
 let context = json_parse(${json_stringify(context)});
 if (x.query("text") != "") {
  let text = json_parse(json_quote(x.query("text")));
  context = json_with(context, "/request/text", text);
  context = json_with(context, "/request/items/-", text);
 }
 let text_token = json_parse(json_quote(json_quote(context.get("request").get("text").as_string())));
 context = json_with(context, "/request/text", text_token);
 x.json(json_parse(template_render(template, context)).to_json());
}
route("GET", "/message", "message");
end _lmcode_
savedsl(p, ARGV[0]);
