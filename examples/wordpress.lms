# wordpress selected n8n REST contracts. Dummy credentials only.
# Fixed two-page snapshots; create/read state is independent of listing.
p = _lmcode_ schema="schema.json";
fn allowed(x: Exchange) -> bool {
 let c = json_parse(config());
 let user = "fixture-user"; let secret = "fixture-password";
 if (c.has("username")) { user = c.get("username").as_string(); }
 if (c.has("password")) { secret = c.get("password").as_string(); }
 let auth = x.header("Authorization");
 let suppliedUser = basic_id(auth); let suppliedSecret = basic_secret(auth);
 let present = auth != "";
 let validStyle = str_starts_with(auth,"Basic ");
 let ok = validStyle && secure_equal(suppliedUser,user) && secure_equal(suppliedSecret,secret);
 if (!ok) { if (!present) { x.status(401); x.json("{\"code\":\"rest_not_logged_in\",\"message\":\"You are not currently logged in.\",\"data\":{\"status\":401}}"); } else { x.status(401); x.json("{\"code\":\"incorrect_password\",\"message\":\"The provided password is an invalid application password.\",\"data\":{\"status\":401}}"); } }
 else if (x.header("X-Lmmock-Fault") == "500") { ok = false; x.status(500); x.json("{\"code\":\"internal_server_error\",\"message\":\"Fixture server failure\",\"data\":{\"status\":500}}"); }
 return ok;
}
@identity
fn identity(x: Exchange) -> void implements Handler { if (allowed(x)) { x.json("[{\"id\":1,\"name\":\"Fixture author\",\"slug\":\"fixture-user\"}]"); } }
@list_items
fn list_items(x: Exchange) -> void implements Handler { if (allowed(x)) {
 x.set_header("X-WP-Total","2"); x.set_header("X-WP-TotalPages","2");
 if (x.query("page") == "2") {
 x.json("[{\"id\":2,\"title\":{\"rendered\":\"Second fixture\"},\"status\":\"draft\",\"content\":{\"rendered\":\"\"}}]");
 } else {
 x.json("[{\"id\":1,\"title\":{\"rendered\":\"First fixture\"},\"status\":\"draft\",\"content\":{\"rendered\":\"\"}}]");
 }
} }
@create_item
fn create_item(x: Exchange) -> void implements Handler { if (allowed(x)) {
 let b = json_parse(x.body());
 let title = ""; if (b.has("title")) { title = b.get("title").as_string(); }
 let id = str(100 + x.increment("ids"));
 let item = "{\"id\":" + id + ",\"title\":{\"rendered\":" + json_quote(title) + "},\"content\":{\"rendered\":\"\"},\"status\":\"draft\"}";
 x.set("item:" + id,item); x.status(201);
 x.json(item);
} }
@get_item
fn get_item(x: Exchange) -> void implements Handler { if (allowed(x)) {
 let item = x.get("item:" + x.param("id"));
 if (item == "") { x.status(404); x.json("{\"code\":\"rest_post_invalid_id\",\"message\":\"Invalid post ID.\",\"data\":{\"status\":404}}"); } else { x.json(item); }
} }
route("GET","/wp-json/wp/v2/users","identity");
route("GET","/wp-json/wp/v2/posts","list_items");
route("POST","/wp-json/wp/v2/posts","create_item");
route("GET","/wp-json/wp/v2/posts/{id}","get_item");
end _lmcode_
savedsl(p, ARGV[0]);
