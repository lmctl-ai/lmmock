# trello HTTP subset for n8n integration tests. Synthetic credentials only.
# Config: {"token":"fixture-token","key":"fixture-key"}. X-Lmmock-Fault: 429 or 500.
p = _lmcode_ schema="schema.json";
fn body_field(x: Exchange, key: string) -> string {
 let value = ""; if (str_starts_with(str_trim(x.body()), "{")) {
  let b = json_parse(x.body()); if (b.has(key)) { value = b.get(key).as_string(); }
 } return value;
}
fn allowed(x: Exchange) -> bool {
 let c = json_parse(config()); let token = "fixture-token"; let key = "fixture-key";
 if (c.has("token")) { token = c.get("token").as_string(); }
 if (c.has("key")) { key = c.get("key").as_string(); }
 let ok = secure_equal(x.query("key"), key) && secure_equal(x.query("token"), token);
 if (x.param("token") != "") { ok = ok && secure_equal(x.param("token"), token); }
 if (!ok) { x.status(401); x.json("{\"message\": \"Invalid credentials\"}"); }
 else if (x.header("X-Lmmock-Fault") == "429") { ok = false; x.set_header("Retry-After","1"); x.status(429); x.json("{\"message\": \"Rate limit exceeded\"}"); }
 else if (x.header("X-Lmmock-Fault") == "500") { ok = false; x.status(500); x.json("{\"message\": \"Fixture server failure\"}"); }
 return ok;
}
@identity
fn identity(x: Exchange) -> void implements Handler { if (allowed(x)) { x.json("{\"id\": \"member-fixture\", \"username\": \"fixture\"}"); } }
@list_items
fn list_items(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  if (x.query("before") != "") { x.json("[]"); } else { x.json("[{\"id\": \"card-1\", \"name\": \"First\", \"idList\": \"list-fixture\"}]"); }
 }
}
@create_item
fn create_item(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let b = json_parse(x.body());
  if (!b.has("idList") || !b.has("name")) { x.status(400); x.json("{\"message\": \"Missing required fields\"}"); }
  else {
   let id = "created-" + str(x.increment("ids"));
   let item = "{\"id\":" + json_quote(id) + ",\"name\":" + b.get("name").to_json() + ",\"idList\":" + b.get("idList").to_json() + ",\"closed\":false}";
   x.set("item:" + id, item); x.status(200); x.json(item);
  }
 }
}
@get_item
fn get_item(x: Exchange) -> void implements Handler {
 if (allowed(x)) {
  let item = x.get("item:" + x.param("id"));
  if (item == "") { x.status(404); x.json("{\"message\": \"Resource not found\"}"); }
  else { x.json(item); }
 }
}
route("GET", "/1/members/me", "identity");
route("GET", "/1/tokens/{token}/member", "identity");
route("GET", "/1/boards/board-fixture/cards", "list_items");
route("POST", "/1/cards", "create_item");
route("GET", "/1/cards/{id}", "get_item");
end _lmcode_
savedsl(p, ARGV[0]);
