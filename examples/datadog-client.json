      },
      "status": 404
    },
    {
      "name": "missing API key",
      "method": "GET",
      "path": "/api/v1/validate",
      "headers": {},
      "json": {
        "errors.0": "Forbidden"
      },
      "status": 403
    },
    {
      "name": "wrong API key",
      "method": "GET",
