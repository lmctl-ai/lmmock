# Scriptable MCP loopback mock. Current stateless Streamable HTTP, legacy
# sessionful Streamable HTTP and legacy HTTP+SSE are intentionally explicit.
p = _lmcode_ schema="../../examples/schema.json";
fn field(j: Json, key: string, fallback: string) -> string {
  let v = fallback;
  if (j.has(key)) {
    v = j.get(key).as_string();
  }
  return v;
}
fn envelope(id: string, result: string) -> string {
  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}";
}
fn error_reply(id: string, code: int, message: string) -> string {
  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + str(code) + ",\"message\":" + json_quote(message) + "}}";
}
fn event(x: Exchange, message: string) -> void {
  x.set_header("Content-Type", "text/event-stream");
  x.set_header("Cache-Control", "no-cache");
  x.stream_event("data: " + message + "\n\n");
}
fn mcp_reply(x: Exchange, body: string) -> void {
  let mode = x.get("mcp:mode");
  if (mode == "") {
    mode = "json";
  }
  if (x.header("X-Mock-Reply-Mode") == "sse" || mode == "sse") {
    event(x, body);
  }
  else {
    x.json(body);
  }
}
fn mcp(x: Exchange, version: string) -> void {
  let raw = x.body();
  let j = json_parse(raw);
  let id = "null";
  let method = "";
  let params = json_parse("{}");
  if (j.has("id")) {
    id = j.get("id").to_json();
  }
  if (j.has("method")) {
    method = j.get("method").as_string();
  }
  if (j.has("params")) {
    params = j.get("params");
  }
  let callName = field(params, "name", field(params, "uri", ""));
  let callNumber = x.increment("mcp:call_count");
  x.set("mcp:call_count", str(callNumber));
  x.set("mcp:call:" + str(callNumber), "{\"method\":" + json_quote(method) + ",\"id\":" + id + ",\"name\":" + json_quote(callName) + "}");
  let headerVersion = x.header("MCP-Protocol-Version");
  let headerMethod = x.header("Mcp-Method");
  let bodyVersion = "";
  if (params.has("_meta") && params.get("_meta").has("io.modelcontextprotocol/protocolVersion")) {
    bodyVersion = params.get("_meta").get("io.modelcontextprotocol/protocolVersion").as_string();
  }
  if (method == "" && (j.has("result") || j.has("error"))) {
    x.status(202);
    x.send("");
  }
  else if (version == "2026-07-28" && headerVersion != "2026-07-28") {
    x.status(400);
    x.json(error_reply(id, -32022, "UnsupportedProtocolVersionError"));
  }
  else if (version == "2026-07-28" && (headerMethod == "" || bodyVersion != headerVersion || headerMethod != method)) {
    x.status(400);
    x.json(error_reply(id, -32020, "HeaderMismatch"));
  }
  else if (version == "2026-07-28" && (method == "tools/call" || method == "resources/read" || method == "prompts/get") && x.header("Mcp-Name") != field(params, "name", field(params, "uri", ""))) {
    x.status(400);
    x.json(error_reply(id, -32020, "HeaderMismatch"));
  }
  else if (version == "2026-07-28" && (!str_contains(x.header("Accept"), "application/json") || !str_contains(x.header("Accept"), "text/event-stream"))) {
    x.status(406);
    x.json(error_reply(id, -32020, "Accept must include application/json and text/event-stream"));
  }
  else if ((method == "notifications/initialized" || method == "notifications/cancelled") && version != "2026-07-28") {
    if (method == "notifications/cancelled" && params.has("requestId")) {
      x.set("cancel:" + params.get("requestId").to_json(), "yes");
    }
    x.status(202);
    x.send("");
  }
  else if (method == "initialize" && version == "2026-07-28") {
    mcp_reply(x, error_reply(id, -32601, "method not found"));
  }
  else if (headerMethod != "" && headerMethod != method) {
    x.status(400);
    mcp_reply(x, error_reply(id, -32020, "HeaderMismatch"));
  }
  else if (method == "ping") {
    mcp_reply(x, envelope(id, "{}"));
  }
  else if (method == "server/discover") {
    mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,\"supportedVersions\":[\"2026-07-28\",\"2025-11-25\",\"2024-11-05\"],\"capabilities\":{\"tools\":{\"listChanged\":true},\"resources\":{\"subscribe\":true,\"listChanged\":true},\"prompts\":{\"listChanged\":true},\"logging\":{}}}"));
  }
  else if (method == "initialize" && version != "2026-07-28") {
    let requested = field(params, "protocolVersion", "");
    if (requested != version) {
      x.status(400);
      mcp_reply(x, error_reply(id, -32602, "unsupported protocol version"));
    }
    else {
      let sid = random_token();
      if (version == "2025-11-25") {
        x.set("session:" + sid, "active");
        x.set_header("Mcp-Session-Id", sid);
      }
      mcp_reply(x, envelope(id, "{\"protocolVersion\":\"" + version + "\",\"capabilities\":{\"tools\":{\"listChanged\":true},\"resources\":{\"listChanged\":true},\"prompts\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"lmmock-mcp\",\"version\":\"1.0.0\"}}"));
    }
  }
  else if (method == "tools/list") {
    let tool0 = "{\"name\":\"echo\",\"description\":\"Return text\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]},\"outputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
    let tool1 = "{\"name\":\"add\",\"description\":\"Add typed numbers\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"left\":{\"type\":\"number\"},\"right\":{\"type\":\"number\"}},\"required\":[\"left\",\"right\"]},\"outputSchema\":{\"type\":\"object\",\"properties\":{\"sum\":{\"type\":\"number\"}},\"required\":[\"sum\"]},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
    let tool2 = "{\"name\":\"slow\",\"description\":\"Cancellable progress fixture\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
    let tool3 = "{\"name\":\"fail\",\"description\":\"Tool error result\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
    let tool4 = "{\"name\":\"crash\",\"description\":\"JSON-RPC error\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
    let tool5 = "{\"name\":\"delete_everything\",\"description\":\"Records invocation only\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":true,\"idempotentHint\":false,\"openWorldHint\":false}}";
    let result = "{\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,\"tools\":[" + tool0 + "," + tool1 + "," + tool2 + "," + tool3 + "," + tool4 + "," + tool5 + "]}";
    mcp_reply(x, envelope(id, result));
  }
  else if (method == "tools/call") {
    let name = field(params, "name", "");
    let args = params.get("arguments");
    if (name == "crash") {
      mcp_reply(x, error_reply(id, -32603, "synthetic crash"));
    }
    else {
      let content = "";
      let structured = "{}";
      let isError = "false";
      if (name == "echo") {
        let value = field(args, "text", "");
        content = "[{\"type\":\"text\",\"text\":" + json_quote(value) + "}]";
        structured = "{\"text\":" + json_quote(value) + "}";
      }
      else if (name == "add") {
        let a = args.get("left").as_float();
        let b = args.get("right").as_float();
        let total = a + b;
        content = "[{\"type\":\"text\",\"text\":" + json_quote(str(total)) + "}]";
        structured = "{\"sum\":" + str(total) + "}";
      }
      else if (name == "slow") {
        let step = 0;
        let stopped = false;
        let requestKey = j.get("id").to_json();
        let progress = "";
        if (params.has("_meta") && params.get("_meta").has("progressToken")) {
          progress = params.get("_meta").get("progressToken").to_json();
        }
        while (step < 20 && !stopped) {
          stopped = !x.pause(25) || x.get("cancel:" + requestKey) == "yes";
          if (!stopped) {
            step = step + 1;
            if (progress != "" && (x.header("X-Mock-Reply-Mode") == "sse" || x.get("mcp:mode") == "sse")) {
              event(x, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":{\"progressToken\":" + progress + ",\"progress\":" + str(step) + "}}");
            }
          }
        }
        if (stopped) {
          x.set("mcp:cancelled_slow", str(x.increment("mcp:cancelled_slow")));
        }
        content = "[{\"type\":\"text\",\"text\":\"slow complete\"}]";
      }
      else if (name == "fail") {
        isError = "true";
        content = "[{\"type\":\"text\",\"text\":\"synthetic tool failure\"}]";
      }
      else if (name == "delete_everything") {
        x.set("recorded:delete_everything", str(x.increment("recorded:delete_everything")));
        content = "[{\"type\":\"text\",\"text\":\"recorded; no deletion performed\"}]";
      }
      else {
        mcp_reply(x, error_reply(id, -32602, "unknown tool"));
        content = "";
      }
      if (content != "") {
        mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"content\":" + content + ",\"structuredContent\":" + structured + ",\"isError\":" + isError + "}"));
      }
    }
  }
  else if (method == "resources/list") {
    mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,\"resources\":[{\"uri\":\"mock://text\",\"name\":\"text\",\"mimeType\":\"text/plain\"},{\"uri\":\"mock://blob\",\"name\":\"blob\",\"mimeType\":\"application/octet-stream\"}]}"));
  }
  else if (method == "resources/read") {
    let uri = field(params, "uri", "");
    if (uri == "mock://text") {
      mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"contents\":[{\"uri\":\"mock://text\",\"mimeType\":\"text/plain\",\"text\":\"fixture text\"}]}"));
    }
    else {
      mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"contents\":[{\"uri\":\"mock://blob\",\"mimeType\":\"application/octet-stream\",\"blob\":\"AAEC\"}]}"));
    }
  }
  else if (method == "resources/templates/list") {
    mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,\"resourceTemplates\":[{\"uriTemplate\":\"mock://item/{id}\",\"name\":\"item\"}]}"));
  }
  else if (method == "prompts/list") {
    mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,\"prompts\":[{\"name\":\"greet\",\"arguments\":[{\"name\":\"name\",\"required\":true}]}]}"));
  }
  else if (method == "prompts/get") {
    let name = "guest";
    if (params.has("arguments") && params.get("arguments").has("name")) {
      name = params.get("arguments").get("name").as_string();
    }
    mcp_reply(x, envelope(id, "{\"resultType\":\"complete\",\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":" + json_quote("Hello " + name) + "}}]}"));
  }
  else if (method == "subscriptions/listen") {
    x.set_header("Content-Type", "text/event-stream");
    x.set_header("Cache-Control", "no-cache");
    let wantsTools = false;
    if (params.has("notifications") && params.get("notifications").has("toolsListChanged")) {
      wantsTools = params.get("notifications").get("toolsListChanged").as_bool();
    }
    let open = true;
    while (open) {
      let changed = x.take("mcp:list_changed");
      if (changed != "" && wantsTools) {
        x.stream_event("id: " + changed + "\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}\n\n");
        open = false;
      }
      else {
        open = x.pause(25);
      }
    }
  }
  else {
    mcp_reply(x, error_reply(id, -32601, "method not found"));
  }
}
fn loopback_host(host: string) -> bool {
  let allowed = host == "localhost" || host == "127.0.0.1" || host == "[::1]";
  let prefix = 0;
  if (str_starts_with(host, "localhost:")) {
    prefix = 10;
  }
  else if (str_starts_with(host, "127.0.0.1:")) {
    prefix = 10;
  }
  else if (str_starts_with(host, "[::1]:")) {
    prefix = 6;
  }
  if (prefix > 0) {
    let port = str_substr(host, prefix, str_len(host) - prefix);
    let digits = port != "";
    for (i in range(0, str_len(port))) {
      if (!str_contains("0123456789", str_substr(port, i, 1))) {
        digits = false;
      }
    }
    if (digits) {
      allowed = true;
    }
  }
  return allowed;
}
fn guard(x: Exchange, c: Json) -> bool {
  let host = x.header("Host");
  let origin = x.header("Origin");
  let allowed = true;
  if (!loopback_host(host)) {
    x.status(403);
    x.json("{\"error\":\"non_loopback_host\"}");
    allowed = false;
  }
  else if (origin != "" && origin != "http://" + host) {
    x.status(403);
    x.json("{\"error\":\"origin_rejected\"}");
    allowed = false;
  }
  let token = field(c, "bearerToken", "");
  if (allowed && token != "" && x.header("Authorization") != "Bearer " + token) {
    x.status(401);
    x.set_header("WWW-Authenticate", "Bearer");
    x.json("{\"error\":\"unauthorized\"}");
    allowed = false;
  }
  return allowed;
}
@streamable
fn streamable(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (guard(x, c)) {
    let v = field(c, "protocolVersion", "2026-07-28");
    if (v == "2025-11-25" && x.method() == "POST") {
      let body = json_parse(x.body());
      let method = field(body, "method", "");
      let sid = x.header("Mcp-Session-Id");
      if (method != "initialize" && x.header("MCP-Protocol-Version") != v) {
        x.status(400);
        x.json("{\"error\":\"protocol_version_mismatch\"}");
      }
      else if (method != "initialize" && (sid == "" || x.get("session:" + sid) != "active")) {
        x.status(404);
        x.json("{\"error\":\"unknown_or_expired_session\"}");
      }
      else {
        mcp(x, v);
      }
    }
    else {
      mcp(x, v);
    }
  }
}
@session_get
fn session_get(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (field(c, "protocolVersion", "2026-07-28") != "2025-11-25") {
    x.status(405);
    x.send("method not allowed");
  }
  else {
    let sid = x.header("Mcp-Session-Id");
    if (x.header("MCP-Protocol-Version") != "2025-11-25") {
      x.status(400);
      x.json("{\"error\":\"protocol_version_mismatch\"}");
    }
    else if (sid == "" || x.get("session:" + sid) != "active") {
      x.status(404);
      x.json("{\"error\":\"unknown_or_expired_session\"}");
    }
    else {
      x.set_header("Content-Type", "text/event-stream");
      x.set_header("Cache-Control", "no-cache");
      let open = true;
      let last = x.header("Last-Event-ID");
      let newest = x.get("mcp:last_event_id");
      if (last != "" && newest != "" && last != newest) {
        let payload = x.get("mcp:event_payload:" + newest);
        if (payload != "") {
          x.stream_event("id: " + newest + "\ndata: " + payload + "\n\n");
        }
        let pending = x.take("mcp:list_changed");
      }
      else if (last != "" && last == newest) {
        let pending = x.take("mcp:list_changed");
      }
      while (open) {
        let changed = x.take("mcp:list_changed");
        if (changed != "") {
          x.stream_event("id: " + changed + "\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}\n\n");
        }
        open = x.pause(25);
      }
    }
  }
}
@session_delete
fn session_delete(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (field(c, "protocolVersion", "2026-07-28") != "2025-11-25") {
    x.status(405);
    x.send("method not allowed");
  }
  else {
    let sid = x.header("Mcp-Session-Id");
    if (x.header("MCP-Protocol-Version") != "2025-11-25") {
      x.status(400);
      x.json("{\"error\":\"protocol_version_mismatch\"}");
    }
    else if (sid == "" || x.take("session:" + sid) == "") {
      x.status(404);
      x.json("{\"error\":\"unknown_or_expired_session\"}");
    }
    else {
      x.status(200);
      x.send("");
    }
  }
}
@sse
fn legacy_sse(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (guard(x, c)) {
    let sid = random_token();
    x.set("sse:" + sid, "active");
    x.set("latest_sse_sid", sid);
    x.set_header("Content-Type", "text/event-stream");
    x.set_header("Cache-Control", "no-cache");
    x.stream_event("event: endpoint\ndata: /messages?session_id=" + sid + "\n\n");
    let open = true;
    while (open) {
      let reply = x.next_queued_response(sid);
      let changed = x.take("sse:changed:" + sid);
      if (reply != "") {
        if (str_starts_with(reply, "E")) {
          x.stream_event("event: message\n" + str_substr(reply, 1, str_len(reply)));
        }
        else {
          x.stream_event("event: message\ndata: " + str_substr(reply, 1, str_len(reply)) + "\n\n");
        }
      }
      else if (changed != "") {
        x.stream_event("id: " + changed + "\nevent: message\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}\n\n");
      }
      open = x.pause(25);
      if (x.get("sse:" + sid) != "active") {
        open = false;
      }
    }
  }
}
@messages
fn messages(x: Exchange) -> void implements Handler {
  let sid = x.query("session_id");
  if (sid == "" || x.get("sse:" + sid) != "active") {
    x.status(404);
    x.json("{\"error\":\"unknown_session\"}");
  }
  else {
    let c = json_parse(config());
    if (guard(x, c)) {
      let j = json_parse(x.body());
      let id = "null";
      if (j.has("id")) {
        id = j.get("id").to_json();
      }
      let method = field(j, "method", "");
      if (method == "notifications/initialized" || method == "notifications/cancelled") {
        x.status(202);
        x.send("");
      }
      else {
        x.queue_response(sid);
        mcp(x, "2024-11-05");
        x.status(202);
      }
    }
  }
}
@control
fn control(x: Exchange) -> void implements Handler {
  let path = x.path();
  if (path == "/__mock/state") {
    let mode = x.get("mcp:mode");
    if (mode == "") {
      mode = "json";
    }
    let deletes = x.get("recorded:delete_everything");
    if (deletes == "") {
      deletes = "0";
    }
    let cancelled = x.get("mcp:cancelled_slow");
    if (cancelled == "") {
      cancelled = "0";
    }
    let countText = x.get("mcp:call_count");
    if (countText == "") {
      countText = "0";
    }
    let count = json_parse(countText).as_int();
    let calls = "[";
    for (i in range(1, count + 1)) {
      if (i > 1) {
        calls = calls + ",";
      }
      calls = calls + x.get("mcp:call:" + str(i));
    }
    calls = calls + "]";
    x.json("{\"replyMode\":\"" + mode + "\",\"deleteCalls\":" + deletes + ",\"cancelledSlow\":" + cancelled + ",\"calls\":" + calls + "}");
  }
  else if (path == "/__mock/reset") {
    x.reset();
    x.json("{\"ok\":true}");
  }
  else if (path == "/__mock/reply-mode") {
    let j = json_parse(x.body());
    let mode = field(j, "mode", "json");
    if (mode != "json" && mode != "sse") {
      x.status(400);
      x.json("{\"error\":\"mode must be json or sse\"}");
    }
    else {
      x.set("mcp:mode", mode);
      x.json("{\"ok\":true}");
    }
  }
  else if (path == "/__mock/list-changed") {
    let id = str(x.increment("mcp:event_id"));
    x.set("mcp:list_changed", id);
    x.set("mcp:last_event_id", id);
    x.set("mcp:event_payload:" + id, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}");
    x.set("sse:changed:" + x.get("latest_sse_sid"), id);
    x.json("{\"ok\":true,\"eventId\":" + id + "}");
  }
  else if (path == "/__mock/expire-session") {
    let sid = field(json_parse(x.body()), "sessionId", "");
    x.take("session:" + sid);
    x.json("{\"ok\":true}");
  }
  else {
    x.status(404);
    x.json("{\"error\":\"not_found\"}");
  }
}
route("POST", "/mcp", "streamable");
route("GET", "/mcp", "session_get");
route("DELETE", "/mcp", "session_delete");
route("GET", "/sse", "sse");
route("POST", "/messages", "messages");
route("GET", "/__mock/state", "control");
route("POST", "/__mock/reset", "control");
route("POST", "/__mock/reply-mode", "control");
route("POST", "/__mock/list-changed", "control");
route("POST", "/__mock/expire-session", "control");
end _lmcode_
r = run_lmcode(p, {
  command:concat(["lmmock","exec","--lmcode","$DSLFILE","--"],ARGV)
}
);
require(r.code == 0, "failed to start MCP mock");
