# Scriptable MCP loopback mock. Current stateless Streamable HTTP, legacy
# sessionful Streamable HTTP and legacy HTTP+SSE are intentionally explicit.
p = _lmcode_ schema="../../examples/schema.json";
fn field(j: Json, key: string, fallback: string) -> string {
  let v = fallback;
  if (j.kind() == "object" && j.has(key)) {
    let child = j.get(key);
    if (child.kind() == "string") {
      v = child.as_string();
    }
  }
  return v;
}
fn is_num(j: Json, key: string) -> bool {
  let ok = false;
  if (j.kind() == "object" && j.has(key)) {
    let k = j.get(key).kind();
    ok = k == "int" || k == "float";
  }
  return ok;
}
fn result_prefix(version: string, cacheable: bool) -> string {
  let prefix = "";
  if (version == "2026-07-28") {
    if (cacheable) {
      prefix = "\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,";
    }
    else {
      prefix = "\"resultType\":\"complete\",";
    }
  }
  return prefix;
}
fn envelope(id: string, result: string) -> string {
  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}";
}
fn error_reply(id: string, code: int, message: string) -> string {
  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + str(code) + ",\"message\":" + json_quote(message) + "}}";
}
fn event(x: Exchange, message: string) -> void {
  x.set_header("Content-Type", "text/event-stream");
  x.set_header("Cache-Control", "no-cache");
  x.stream_event("data: " + message + "\n\n");
}
fn mcp_reply(x: Exchange, body: string) -> void {
  let mode = x.get("mcp:mode");
  if (mode == "") {
    mode = "json";
  }
  if (x.header("X-Mock-Reply-Mode") == "sse" || mode == "sse") {
    event(x, body);
  }
  else {
    x.json(body);
  }
}
fn record_cancel(x: Exchange, ver: string, reqId: string) -> void {
  if (x.get("cancel:counted:" + reqId) == "") {
    x.set("cancel:counted:" + reqId, "yes");
    x.increment("mcp:cancelled_slow");
    x.increment("mcp:cancelled_slow:" + ver);
    let idx = x.increment("mcp:cancelled_req_count");
    x.set("mcp:cancelled_req:" + str(idx), reqId);
  }
}
fn mcp(x: Exchange, version: string) -> void {
  let raw = x.body();
  let j = json_parse(raw);
  let id = "null";
  let hasId = false;
  let method = "";
  let params = json_parse("{}");
  if (j.has("id")) {
    id = j.get("id").to_json();
    if (id != "null") {
      hasId = true;
    }
  }
  if (j.has("method") && j.get("method").kind() == "string") {
    method = j.get("method").as_string();
  }
  if (j.has("params") && j.get("params").kind() == "object") {
    params = j.get("params");
  }
  let callName = field(params, "name", field(params, "uri", ""));
  let callNumber = x.increment("mcp:call_count");
  x.set("mcp:call:" + str(callNumber), "{\"method\":" + json_quote(method) + ",\"id\":" + id + ",\"name\":" + json_quote(callName) + "}");
  let headerVersion = x.header("MCP-Protocol-Version");
  let headerMethod = x.header("Mcp-Method");
  let bodyVersion = "";
  if (params.has("_meta") && params.get("_meta").kind() == "object") {
    bodyVersion = field(params.get("_meta"), "io.modelcontextprotocol/protocolVersion", "");
  }
  let isNotif = str_starts_with(method, "notifications/");
  if (method == "" && (j.has("result") || j.has("error"))) {
    if (version == "2026-07-28") {
      x.status(400);
      x.json(error_reply(id, -32600, "JSON-RPC responses are not accepted on stateless POST /mcp"));
    }
    else {
      x.status(202);
      x.send("");
    }
  }
  else if (version == "2026-07-28" && (headerMethod == "" || bodyVersion != headerVersion || headerMethod != method)) {
    x.status(400);
    x.json(error_reply(id, -32020, "HeaderMismatch"));
  }
  else if (version == "2026-07-28" && headerVersion != "2026-07-28") {
    x.status(400);
    x.json(error_reply(id, -32022, "UnsupportedProtocolVersionError"));
  }
  else if (version == "2026-07-28" && (method == "tools/call" || method == "resources/read" || method == "prompts/get") && x.header("Mcp-Name-Decoded") != field(params, "name", field(params, "uri", ""))) {
    x.status(400);
    x.json(error_reply(id, -32020, "HeaderMismatch"));
  }
  else if (version == "2026-07-28" && (!str_contains(x.header("Accept"), "application/json") || !str_contains(x.header("Accept"), "text/event-stream"))) {
    x.status(406);
    x.json(error_reply(id, -32020, "Accept must include application/json and text/event-stream"));
  }
  else if (method == "notifications/initialized" || method == "notifications/cancelled") {
    if (method == "notifications/cancelled" && params.has("requestId")) {
      let reqId = params.get("requestId").to_json();
      x.set("cancel:" + reqId, "yes");
      let inflightVer = x.get("slow:inflight:" + reqId);
      if (inflightVer != "" && x.get("slow:done:" + reqId) == "") {
        record_cancel(x, inflightVer, reqId);
      }
    }
    x.status(202);
    x.send("");
  }
  else if (!isNotif && (method == "" || !hasId)) {
    x.status(400);
    x.json(error_reply("null", -32600, "Invalid Request"));
  }
  else if (method == "initialize" && version == "2026-07-28") {
    x.status(404);
    mcp_reply(x, error_reply(id, -32601, "method not found"));
  }
  else if (headerMethod != "" && headerMethod != method) {
    x.status(400);
    mcp_reply(x, error_reply(id, -32020, "HeaderMismatch"));
  }
  else if (method == "ping" && version != "2026-07-28") {
    mcp_reply(x, envelope(id, "{}"));
  }
  else if (method == "server/discover" && version == "2026-07-28") {
    mcp_reply(x, envelope(id, "{\"_meta\":{\"io.modelcontextprotocol/serverInfo\":{\"name\":\"lmmock-mcp\",\"version\":\"1.0.0\"}},\"resultType\":\"complete\",\"cacheScope\":\"public\",\"ttlMs\":0,\"supportedVersions\":[\"2026-07-28\",\"2025-11-25\",\"2024-11-05\"],\"capabilities\":{\"tools\":{\"listChanged\":true},\"resources\":{\"listChanged\":true},\"prompts\":{\"listChanged\":true}}}"));
  }
  else if (method == "initialize" && version != "2026-07-28") {
    let requested = field(params, "protocolVersion", "");
    if (requested == "") {
      x.status(400);
      mcp_reply(x, error_reply(id, -32602, "missing protocol version"));
    }
    else {
      let sid = random_token();
      if (version == "2025-11-25") {
        x.set("session:" + sid, "active");
        x.set_header("Mcp-Session-Id", sid);
      }
      mcp_reply(x, envelope(id, "{\"protocolVersion\":\"" + version + "\",\"capabilities\":{\"tools\":{\"listChanged\":true},\"resources\":{\"listChanged\":true},\"prompts\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"lmmock-mcp\",\"version\":\"1.0.0\"}}"));
    }
  }
  else if (method == "tools/list") {
    let result = "";
    if (version == "2024-11-05") {
      let l0 = "{\"name\":\"echo\",\"description\":\"Return text\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}}";
      let l1 = "{\"name\":\"add\",\"description\":\"Add typed numbers\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"left\":{\"type\":\"number\"},\"right\":{\"type\":\"number\"}},\"required\":[\"left\",\"right\"]}}";
      let l2 = "{\"name\":\"slow\",\"description\":\"Cancellable progress fixture\",\"inputSchema\":{\"type\":\"object\"}}";
      let l3 = "{\"name\":\"fail\",\"description\":\"Tool error result\",\"inputSchema\":{\"type\":\"object\"}}";
      let l4 = "{\"name\":\"crash\",\"description\":\"JSON-RPC error\",\"inputSchema\":{\"type\":\"object\"}}";
      let l5 = "{\"name\":\"delete_everything\",\"description\":\"Records invocation only\",\"inputSchema\":{\"type\":\"object\"}}";
      result = "{\"tools\":[" + l0 + "," + l1 + "," + l2 + "," + l3 + "," + l4 + "," + l5 + "]}";
    }
    else {
      let tool0 = "{\"name\":\"echo\",\"description\":\"Return text\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]},\"outputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
      let tool1 = "{\"name\":\"add\",\"description\":\"Add typed numbers\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"left\":{\"type\":\"number\"},\"right\":{\"type\":\"number\"}},\"required\":[\"left\",\"right\"]},\"outputSchema\":{\"type\":\"object\",\"properties\":{\"sum\":{\"type\":\"number\"}},\"required\":[\"sum\"]},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
      let tool2 = "{\"name\":\"slow\",\"description\":\"Cancellable progress fixture\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
      let tool3 = "{\"name\":\"fail\",\"description\":\"Tool error result\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
      let tool4 = "{\"name\":\"crash\",\"description\":\"JSON-RPC error\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}";
      let tool5 = "{\"name\":\"delete_everything\",\"description\":\"Records invocation only\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":true,\"idempotentHint\":false,\"openWorldHint\":false}}";
      result = "{" + result_prefix(version, true) + "\"tools\":[" + tool0 + "," + tool1 + "," + tool2 + "," + tool3 + "," + tool4 + "," + tool5 + "]}";
    }
    mcp_reply(x, envelope(id, result));
  }
  else if (method == "tools/call") {
    let name = field(params, "name", "");
    let args = json_parse("{}");
    if (params.has("arguments") && params.get("arguments").kind() == "object") {
      args = params.get("arguments");
    }
    if (name == "crash") {
      mcp_reply(x, error_reply(id, -32603, "synthetic crash"));
    }
    else {
      let content = "";
      let structured = "";
      let isError = "false";
      if (name == "echo") {
        let value = field(args, "text", "");
        content = "[{\"type\":\"text\",\"text\":" + json_quote(value) + "}]";
        structured = "{\"text\":" + json_quote(value) + "}";
      }
      else if (name == "add") {
        if (!is_num(args, "left") || !is_num(args, "right")) {
          mcp_reply(x, error_reply(id, -32602, "add requires numeric left and right arguments"));
        }
        else {
          let a = args.get("left").as_float();
          let b = args.get("right").as_float();
          let total = a + b;
          content = "[{\"type\":\"text\",\"text\":" + json_quote(str(total)) + "}]";
          structured = "{\"sum\":" + str(total) + "}";
        }
      }
      else if (name == "slow") {
        let step = 0;
        let stopped = false;
        let cancelledByNotif = false;
        let disconnected = false;
        let requestKey = id;
        let progress = "";
        let isSse = version == "2024-11-05" || x.header("X-Mock-Reply-Mode") == "sse" || x.get("mcp:mode") == "sse";
        x.set("slow:inflight:" + requestKey, version);
        if (params.has("_meta") && params.get("_meta").kind() == "object" && params.get("_meta").has("progressToken")) {
          progress = params.get("_meta").get("progressToken").to_json();
        }
        if (isSse && version != "2024-11-05") {
          x.set_header("Content-Type", "text/event-stream");
          x.set_header("Cache-Control", "no-cache");
          x.stream_event("");
        }
        while (step < 5 && !stopped) {
          let alive = x.pause(60);
          if (x.get("cancel:" + requestKey) == "yes") {
            cancelledByNotif = true;
            stopped = true;
          }
          else if (!alive) {
            disconnected = true;
            stopped = true;
          }
          if (!stopped) {
            step = step + 1;
            if (progress != "" && isSse) {
              event(x, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":{\"progressToken\":" + progress + ",\"progress\":" + str(step) + ",\"total\":5}}");
            }
          }
        }
        let wasCancelled = cancelledByNotif || (version == "2026-07-28" && disconnected);
        if (wasCancelled) {
          record_cancel(x, version, requestKey);
          if (version == "2025-11-25" && !isSse) {
            x.status(204);
            x.send("");
          }
        }
        else if (!disconnected) {
          x.set("slow:done:" + requestKey, "yes");
          content = "[{\"type\":\"text\",\"text\":\"slow complete\"}]";
        }
      }
      else if (name == "fail") {
        isError = "true";
        content = "[{\"type\":\"text\",\"text\":\"synthetic tool failure\"}]";
      }
      else if (name == "delete_everything") {
        x.increment("recorded:delete_everything");
        content = "[{\"type\":\"text\",\"text\":\"recorded; no deletion performed\"}]";
      }
      else {
        mcp_reply(x, error_reply(id, -32602, "unknown tool"));
        content = "";
      }
      if (content != "") {
        let scPart = "";
        if (version != "2024-11-05" && structured != "") {
          scPart = ",\"structuredContent\":" + structured;
        }
        mcp_reply(x, envelope(id, "{" + result_prefix(version, false) + "\"content\":" + content + scPart + ",\"isError\":" + isError + "}"));
      }
    }
  }
  else if (method == "resources/list") {
    mcp_reply(x, envelope(id, "{" + result_prefix(version, true) + "\"resources\":[{\"uri\":\"mock://text\",\"name\":\"text\",\"mimeType\":\"text/plain\"},{\"uri\":\"mock://blob\",\"name\":\"blob\",\"mimeType\":\"application/octet-stream\"}]}"));
  }
  else if (method == "resources/read") {
    let uri = field(params, "uri", "");
    if (uri == "mock://text") {
      mcp_reply(x, envelope(id, "{" + result_prefix(version, true) + "\"contents\":[{\"uri\":\"mock://text\",\"mimeType\":\"text/plain\",\"text\":\"fixture text\"}]}"));
    }
    else if (uri == "mock://blob") {
      mcp_reply(x, envelope(id, "{" + result_prefix(version, true) + "\"contents\":[{\"uri\":\"mock://blob\",\"mimeType\":\"application/octet-stream\",\"blob\":\"AAEC\"}]}"));
    }
    else if (str_starts_with(uri, "mock://item/") && str_len(uri) > 12) {
      let itemId = str_substr(uri, 12, str_len(uri) - 12);
      mcp_reply(x, envelope(id, "{" + result_prefix(version, true) + "\"contents\":[{\"uri\":" + json_quote(uri) + ",\"mimeType\":\"text/plain\",\"text\":" + json_quote("item " + itemId) + "}]}"));
    }
    else {
      let errCode = -32002;
      if (version == "2026-07-28") {
        errCode = -32602;
      }
      mcp_reply(x, error_reply(id, errCode, "resource not found"));
    }
  }
  else if (method == "resources/templates/list") {
    mcp_reply(x, envelope(id, "{" + result_prefix(version, true) + "\"resourceTemplates\":[{\"uriTemplate\":\"mock://item/{id}\",\"name\":\"item\"}]}"));
  }
  else if (method == "prompts/list") {
    mcp_reply(x, envelope(id, "{" + result_prefix(version, true) + "\"prompts\":[{\"name\":\"greet\",\"arguments\":[{\"name\":\"name\",\"required\":true}]}]}"));
  }
  else if (method == "prompts/get") {
    let promptName = field(params, "name", "");
    if (promptName != "greet") {
      mcp_reply(x, error_reply(id, -32602, "unknown prompt"));
    }
    else {
      let name = "guest";
      if (params.has("arguments") && params.get("arguments").kind() == "object") {
        name = field(params.get("arguments"), "name", "guest");
      }
      mcp_reply(x, envelope(id, "{" + result_prefix(version, false) + "\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":" + json_quote("Hello " + name) + "}}]}"));
    }
  }
  else if (method == "subscriptions/listen" && version == "2026-07-28") {
    x.set_header("Content-Type", "text/event-stream");
    x.set_header("Cache-Control", "no-cache");
    let wantsTools = false;
    let wantsToolsJson = "false";
    if (params.has("notifications") && params.get("notifications").kind() == "object" && params.get("notifications").has("toolsListChanged") && params.get("notifications").get("toolsListChanged").kind() == "bool") {
      wantsTools = params.get("notifications").get("toolsListChanged").as_bool();
      if (wantsTools) {
        wantsToolsJson = "true";
      }
    }
    let subMeta = "{\"io.modelcontextprotocol/subscriptionId\":" + id + "}";
    x.stream_event("data: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/subscriptions/acknowledged\",\"params\":{\"_meta\":" + subMeta + ",\"notifications\":{\"toolsListChanged\":" + wantsToolsJson + "}}}\n\n");
    let seen = x.get("mcp:last_event_id");
    let open = true;
    while (open) {
      let changed = x.get("mcp:last_event_id");
      if (changed != "" && changed != seen) {
        seen = changed;
        if (wantsTools) {
          x.stream_event("id: " + changed + "\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\",\"params\":{\"_meta\":" + subMeta + "}}\n\n");
          x.stream_event("data: " + envelope(id, "{\"_meta\":" + subMeta + ",\"resultType\":\"complete\"}") + "\n\n");
          open = false;
        }
      }
      if (open) {
        open = x.pause(25);
      }
    }
  }
  else {
    if (version == "2026-07-28") {
      x.status(404);
    }
    mcp_reply(x, error_reply(id, -32601, "method not found"));
  }
}
fn loopback_host(host: string) -> bool {
  let allowed = host == "localhost" || host == "127.0.0.1" || host == "[::1]";
  let prefix = 0;
  if (str_starts_with(host, "localhost:")) {
    prefix = 10;
  }
  else if (str_starts_with(host, "127.0.0.1:")) {
    prefix = 10;
  }
  else if (str_starts_with(host, "[::1]:")) {
    prefix = 6;
  }
  if (prefix > 0) {
    let port = str_substr(host, prefix, str_len(host) - prefix);
    let digits = port != "";
    for (i in range(0, str_len(port))) {
      if (!str_contains("0123456789", str_substr(port, i, 1))) {
        digits = false;
      }
    }
    if (digits) {
      allowed = true;
    }
  }
  return allowed;
}
fn guard(x: Exchange, c: Json) -> bool {
  let host = x.header("Host");
  let origin = x.header("Origin");
  let scheme = x.header(":scheme");
  if (scheme == "") {
    scheme = "http";
  }
  let allowed = true;
  if (!loopback_host(host)) {
    x.status(403);
    x.json("{\"error\":\"non_loopback_host\"}");
    allowed = false;
  }
  else if (origin != "" && origin != scheme + "://" + host) {
    x.status(403);
    x.json("{\"error\":\"origin_rejected\"}");
    allowed = false;
  }
  let token = field(c, "bearerToken", "");
  if (allowed && token != "" && x.header("Authorization") != "Bearer " + token) {
    x.status(401);
    x.set_header("WWW-Authenticate", "Bearer");
    x.json("{\"error\":\"unauthorized\"}");
    allowed = false;
  }
  return allowed;
}
fn control_guard(x: Exchange, c: Json) -> bool {
  let allowed = false;
  if (x.header("Origin") != "") {
    x.status(403);
    x.json("{\"error\":\"origin_rejected\"}");
  }
  else {
    allowed = guard(x, c);
  }
  return allowed;
}
@streamable
fn streamable(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (guard(x, c)) {
    let v = field(c, "protocolVersion", "2026-07-28");
    let kind = x.header(":body_json_kind");
    if (kind == "invalid") {
      x.status(400);
      x.json(error_reply("null", -32700, "Parse error"));
    }
    else if (kind != "object") {
      x.status(400);
      x.json(error_reply("null", -32600, "Invalid Request"));
    }
    else if (v == "2025-11-25" && x.method() == "POST") {
      let body = json_parse(x.body());
      let method = field(body, "method", "");
      let sid = x.header("Mcp-Session-Id");
      if (!str_contains(x.header("Accept"), "application/json") || !str_contains(x.header("Accept"), "text/event-stream")) {
        x.status(406);
        x.json(error_reply("null", -32020, "Accept must include application/json and text/event-stream"));
      }
      else if (method != "initialize" && x.header("MCP-Protocol-Version") != v) {
        x.status(400);
        x.json("{\"error\":\"protocol_version_mismatch\"}");
      }
      else if (method != "initialize" && sid == "") {
        x.status(400);
        x.json("{\"error\":\"missing_session_id\"}");
      }
      else if (method != "initialize" && x.get("session:" + sid) != "active") {
        x.status(404);
        x.json("{\"error\":\"unknown_or_expired_session\"}");
      }
      else {
        mcp(x, v);
      }
    }
    else {
      mcp(x, v);
    }
  }
}
@session_get
fn session_get(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (guard(x, c)) {
    if (field(c, "protocolVersion", "2026-07-28") != "2025-11-25") {
      x.status(405);
      x.send("method not allowed");
    }
    else {
      let sid = x.header("Mcp-Session-Id");
      if (x.header("MCP-Protocol-Version") != "2025-11-25") {
        x.status(400);
        x.json("{\"error\":\"protocol_version_mismatch\"}");
      }
      else if (!str_contains(x.header("Accept"), "text/event-stream")) {
        x.status(406);
        x.json("{\"error\":\"accept_must_include_event_stream\"}");
      }
      else if (sid == "") {
        x.status(400);
        x.json("{\"error\":\"missing_session_id\"}");
      }
      else if (x.get("session:" + sid) != "active") {
        x.status(404);
        x.json("{\"error\":\"unknown_or_expired_session\"}");
      }
      else {
        x.set_header("Content-Type", "text/event-stream");
        x.set_header("Cache-Control", "no-cache");
        x.stream_event("");
        let open = true;
        let last = x.header("Last-Event-ID");
        let seen = x.get("mcp:last_event_id");
        if (last != "" && seen != "" && last != seen) {
          let payload = x.get("mcp:event_payload:" + seen);
          if (payload != "") {
            x.stream_event("id: " + seen + "\ndata: " + payload + "\n\n");
          }
        }
        while (open) {
          let changed = x.get("mcp:last_event_id");
          if (changed != "" && changed != seen) {
            seen = changed;
            let payload = x.get("mcp:event_payload:" + changed);
            if (payload == "") {
              payload = "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}";
            }
            x.stream_event("id: " + changed + "\ndata: " + payload + "\n\n");
          }
          open = x.pause(25);
          if (x.get("session:" + sid) != "active") {
            open = false;
          }
        }
      }
    }
  }
}
@session_delete
fn session_delete(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (guard(x, c)) {
    if (field(c, "protocolVersion", "2026-07-28") != "2025-11-25") {
      x.status(405);
      x.send("method not allowed");
    }
    else {
      let sid = x.header("Mcp-Session-Id");
      if (x.header("MCP-Protocol-Version") != "2025-11-25") {
        x.status(400);
        x.json("{\"error\":\"protocol_version_mismatch\"}");
      }
      else if (sid == "") {
        x.status(400);
        x.json("{\"error\":\"missing_session_id\"}");
      }
      else if (x.take("session:" + sid) == "") {
        x.status(404);
        x.json("{\"error\":\"unknown_or_expired_session\"}");
      }
      else {
        x.status(200);
        x.send("");
      }
    }
  }
}
@sse
fn legacy_sse(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (guard(x, c)) {
    let sid = random_token();
    x.set("sse:" + sid, "active");
    x.set_header("Content-Type", "text/event-stream");
    x.set_header("Cache-Control", "no-cache");
    x.stream_event("event: endpoint\ndata: /messages?session_id=" + sid + "\n\n");
    let seen = x.get("mcp:last_event_id");
    let open = true;
    while (open) {
      let reply = x.next_queued_response(sid);
      let changed = x.get("mcp:last_event_id");
      if (reply != "") {
        if (str_starts_with(reply, "E")) {
          x.stream_event("event: message\n" + str_substr(reply, 1, str_len(reply)));
        }
        else {
          x.stream_event("event: message\ndata: " + str_substr(reply, 1, str_len(reply)) + "\n\n");
        }
      }
      else if (changed != "" && changed != seen) {
        seen = changed;
        x.stream_event("id: " + changed + "\nevent: message\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}\n\n");
      }
      if (reply == "") {
        open = x.pause(25);
      }
      else {
        open = x.pause(0);
      }
      if (x.get("sse:" + sid) != "active") {
        open = false;
      }
    }
  }
}
@messages
fn messages(x: Exchange) -> void implements Handler {
  let sid = x.query("session_id");
  if (sid == "" || x.get("sse:" + sid) != "active") {
    x.status(404);
    x.json("{\"error\":\"unknown_session\"}");
  }
  else {
    let c = json_parse(config());
    if (guard(x, c)) {
      let kind = x.header(":body_json_kind");
      if (kind == "invalid") {
        x.status(400);
        x.json(error_reply("null", -32700, "Parse error"));
      }
      else if (kind != "object") {
        x.status(400);
        x.json(error_reply("null", -32600, "Invalid Request"));
      }
      else {
        let j = json_parse(x.body());
        let id = "null";
        let hasId = false;
        if (j.has("id")) {
          id = j.get("id").to_json();
          if (id != "null") {
            hasId = true;
          }
        }
        let method = field(j, "method", "");
        if (method == "notifications/initialized" || method == "notifications/cancelled") {
          mcp(x, "2024-11-05");
        }
        else if (method == "" && (j.has("result") || j.has("error"))) {
          x.status(202);
          x.send("");
        }
        else if (!str_starts_with(method, "notifications/") && (method == "" || !hasId)) {
          x.status(400);
          x.json(error_reply("null", -32600, "Invalid Request"));
        }
        else {
          x.queue_response(sid);
          mcp(x, "2024-11-05");
          x.status(202);
        }
      }
    }
  }
}
@control
fn control(x: Exchange) -> void implements Handler {
  let c = json_parse(config());
  if (control_guard(x, c)) {
    let path = x.path();
    if (path == "/__mock/state") {
      let mode = x.get("mcp:mode");
      if (mode == "") {
        mode = "json";
      }
      let deletes = x.get("recorded:delete_everything");
      if (deletes == "") {
        deletes = "0";
      }
      let cancelled = x.get("mcp:cancelled_slow");
      if (cancelled == "") {
        cancelled = "0";
      }
      let c2026 = x.get("mcp:cancelled_slow:2026-07-28");
      if (c2026 == "") {
        c2026 = "0";
      }
      let c2025 = x.get("mcp:cancelled_slow:2025-11-25");
      if (c2025 == "") {
        c2025 = "0";
      }
      let c2024 = x.get("mcp:cancelled_slow:2024-11-05");
      if (c2024 == "") {
        c2024 = "0";
      }
      let byVer = "{\"2026-07-28\":" + c2026 + ",\"2025-11-25\":" + c2025 + ",\"2024-11-05\":" + c2024 + "}";
      let cancelledReqCountText = x.get("mcp:cancelled_req_count");
      if (cancelledReqCountText == "") {
        cancelledReqCountText = "0";
      }
      let cancelledReqCount = json_parse(cancelledReqCountText).as_int();
      let cancelledReqIds = "[";
      for (i in range(1, cancelledReqCount + 1)) {
        if (i > 1) {
          cancelledReqIds = cancelledReqIds + ",";
        }
        cancelledReqIds = cancelledReqIds + x.get("mcp:cancelled_req:" + str(i));
      }
      cancelledReqIds = cancelledReqIds + "]";
      let countText = x.get("mcp:call_count");
      if (countText == "") {
        countText = "0";
      }
      let count = json_parse(countText).as_int();
      let calls = "[";
      for (i in range(1, count + 1)) {
        if (i > 1) {
          calls = calls + ",";
        }
        calls = calls + x.get("mcp:call:" + str(i));
      }
      calls = calls + "]";
      x.json("{\"replyMode\":\"" + mode + "\",\"deleteCalls\":" + deletes + ",\"cancelledSlow\":" + cancelled + ",\"cancelledByVersion\":" + byVer + ",\"cancelledRequestIds\":" + cancelledReqIds + ",\"calls\":" + calls + "}");
    }
    else if (path == "/__mock/reset") {
      x.reset();
      x.json("{\"ok\":true}");
    }
    else if (path == "/__mock/reply-mode") {
      if (x.header(":body_json_kind") != "object") {
        x.status(400);
        x.json("{\"error\":\"expected JSON object\"}");
      }
      else {
        let j = json_parse(x.body());
        let mode = field(j, "mode", "json");
        if (mode != "json" && mode != "sse") {
          x.status(400);
          x.json("{\"error\":\"mode must be json or sse\"}");
        }
        else {
          x.set("mcp:mode", mode);
          x.json("{\"ok\":true}");
        }
      }
    }
    else if (path == "/__mock/list-changed") {
      let id = str(x.increment("mcp:event_id"));
      x.set("mcp:list_changed", id);
      x.set("mcp:last_event_id", id);
      x.set("mcp:event_payload:" + id, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\"}");
      x.json("{\"ok\":true,\"eventId\":" + id + "}");
    }
    else if (path == "/__mock/expire-session") {
      if (x.header(":body_json_kind") != "object") {
        x.status(400);
        x.json("{\"error\":\"expected JSON object\"}");
      }
      else {
        let sid = field(json_parse(x.body()), "sessionId", "");
        x.take("session:" + sid);
        x.json("{\"ok\":true}");
      }
    }
    else {
      x.status(404);
      x.json("{\"error\":\"not_found\"}");
    }
  }
}
route("POST", "/mcp", "streamable");
route("GET", "/mcp", "session_get");
route("DELETE", "/mcp", "session_delete");
route("GET", "/sse", "sse");
route("POST", "/messages", "messages");
route("GET", "/__mock/state", "control");
route("POST", "/__mock/reset", "control");
route("POST", "/__mock/reply-mode", "control");
route("POST", "/__mock/list-changed", "control");
route("POST", "/__mock/expire-session", "control");
end _lmcode_
r = run_lmcode(p, {
  command:concat(["lmmock","exec","--lmcode","$DSLFILE","--"],ARGV)
}
);
require(r.code == 0, "failed to start MCP mock");
