# Telegram Bot API fixture (api.telegram.org/bot<TOKEN>/<method>), mined from n8n nodes/Telegram
# (GenericFunctions.ts: `${baseUrl}/bot${accessToken}/${endpoint}`) and credentials/TelegramApi.
# Auth: the bot token travels in the path (default 123456:fixture-telegram-token; config {"token": "..."}).
# Every reply is {"ok":true,"result":...} or {"ok":false,"error_code":N,"description":"..."}.
# Faults: chat_id 429 -> 429 Too Many Requests with parameters.retry_after; chat_id 500 -> 500.
p = _lmcode_ schema="schema.json";
fn field(j: Json, key: string) -> string { let v = ""; if (j.has(key)) { let t = j.get(key).to_json(); if (str_starts_with(t, "\"")) { v = j.get(key).as_string(); } else { v = t; } } return v; }
fn arg(x: Exchange, key: string) -> string {
 let b = str_trim(x.body()); let v = "";
 if (str_starts_with(b, "{")) { v = field(json_parse(b), key); } else if (b != "") { v = form_get(b, key); }
 if (v == "") { v = x.query(key); }
 return v;
}
fn fail(x: Exchange, code: int, description: string) -> void { x.status(code); x.json("{\"ok\":false,\"error_code\":" + str(code) + ",\"description\":" + json_quote(description) + "}"); }
fn chat_json(id: string) -> string { let v = json_quote(id); if (str_is_int(id)) { v = id; } return "{\"id\":" + v + ",\"type\":\"private\",\"first_name\":\"Fixture\",\"username\":\"fixture_user\"}"; }
fn bot_json() -> string { return "{\"id\":123456,\"is_bot\":true,\"first_name\":\"lmmock\",\"username\":\"lmmock_bot\"}"; }
@method
fn method(x: Exchange) -> void implements Handler {
 let c = json_parse(config()); let want = "123456:fixture-telegram-token"; if (c.has("token")) { want = field(c, "token"); }
 let m = x.param("method"); let chat = arg(x, "chat_id"); let segment = x.param("bot");
 # Go's ServeMux wildcards span whole segments, so the "bot<TOKEN>" segment is split here.
 if (!str_starts_with(segment, "bot") || !secure_equal(str_substr(segment, 3, str_len(segment)), want)) { fail(x, 401, "Unauthorized"); }
 else if (m == "getMe") { x.json("{\"ok\":true,\"result\":{\"id\":123456,\"is_bot\":true,\"first_name\":\"lmmock\",\"username\":\"lmmock_bot\",\"can_join_groups\":true,\"can_read_all_group_messages\":false,\"supports_inline_queries\":false}}"); }
 else if (m == "getUpdates") { x.json("{\"ok\":true,\"result\":[]}"); }
 else if (m == "sendMessage" || m == "sendPhoto" || m == "sendDocument" || m == "getChat" || m == "sendChatAction") {
  if (chat == "") { fail(x, 400, "Bad Request: chat_id is empty"); }
  else if (chat == "429") { x.set_header("Retry-After", "1"); x.status(429); x.json("{\"ok\":false,\"error_code\":429,\"description\":\"Too Many Requests: retry after 1\",\"parameters\":{\"retry_after\":1}}"); }
  else if (chat == "500") { fail(x, 500, "Internal Server Error"); }
  else if (chat == "404") { fail(x, 400, "Bad Request: chat not found"); }
  else if (m == "getChat") { x.json("{\"ok\":true,\"result\":" + chat_json(chat) + "}"); }
  else if (m == "sendChatAction") { x.json("{\"ok\":true,\"result\":true}"); }
  else {
   let text = arg(x, "text"); if (m != "sendMessage") { text = arg(x, "caption"); }
   if (m == "sendMessage" && text == "") { fail(x, 400, "Bad Request: message text is empty"); }
   else {
    let n = x.increment("telegram-message"); let extra = "";
    if (m == "sendPhoto") { extra = ",\"photo\":[{\"file_id\":\"AgACfixturephoto\",\"file_unique_id\":\"fixture\",\"width\":100,\"height\":100}]"; }
    if (m == "sendDocument") { extra = ",\"document\":{\"file_id\":\"BQACfixturedoc\",\"file_unique_id\":\"fixturedoc\",\"file_name\":\"fixture.txt\"}"; }
    x.json("{\"ok\":true,\"result\":{\"message_id\":" + str(n) + ",\"from\":" + bot_json() + ",\"chat\":" + chat_json(chat) + ",\"date\":1700000000,\"text\":" + json_quote(text) + extra + "}}");
   }
  }
 }
 else { fail(x, 404, "Not Found"); }
}
route("GET", "/{bot}/{method}", "method"); route("POST", "/{bot}/{method}", "method");
end _lmcode_
savedsl(p, ARGV[0]);
