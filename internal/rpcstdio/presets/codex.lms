p = _lmcode_ schema="schema.json";

fn field(j: Json, k: string) -> string { let s = ""; if (j.has(k)) { s = j.get(k).as_string(); } return s; }
fn cell(x: RPC, input: string) -> Json {
 let cfg = json_parse(config()); let cells = cfg.get("cells"); let turn = x.next("turn");
 let found = json_parse("{}"); let hits = 0;
 for (i in range(0, cells.len())) { let c = cells.at(i); if (c.get("alias").as_string() == x.alias() && c.get("turn").as_int() == turn) { found = c; hits = hits + 1; } }
 if (hits != 1) { x.abort("unscripted or duplicate cell for alias " + x.alias() + " turn " + str(turn)); }
 if (found.has("delay") || found.has("delayMs") || found.has("timeout") || found.has("hang")) { x.abort("timing faults are not supported"); }
 if (found.has("expect")) { if (!str_contains(input, found.get("expect").as_string())) { x.abort("cell prompt expectation failed"); } }
 if (!found.has("text") && !found.has("error")) { x.abort("cell requires explicit text or error"); }
 return found;
}
fn sid() -> string { return json_parse(config()).get("session").as_string(); }

@init fn init(x: RPC) -> void implements RPCHandler {x.reply("{\"userAgent\":\"lmmock\"}");}
@noop fn noop(x: RPC) -> void implements RPCHandler {}
@open fn open(x: RPC) -> void implements RPCHandler {let p=json_parse(x.params());if(x.method()=="thread/resume" && field(p,"threadId")!=sid()){x.error(-32002,"unknown thread");x.abort("scripted error");}x.set("open","yes");x.reply("{\"thread\":{\"id\":"+json_quote(sid())+"}}");}
@turn fn turncall(x: RPC) -> void implements RPCHandler {
 if(x.get("open")!="yes"){x.abort("thread must be opened");}let c=cell(x,x.params());if(c.has("error")){x.error(-32000,c.get("error").as_string());x.abort("scripted error");}
 let t="{\"id\":\"turn-fixture\",\"status\":\"completed\",\"error\":null}";
 x.reply("{\"turn\":{\"id\":\"turn-fixture\"}}");
 x.notify("turn/started","{\"threadId\":"+json_quote(sid())+",\"turn\":{\"id\":\"turn-fixture\"}}");
 x.notify("item/agentMessage/delta","{\"threadId\":"+json_quote(sid())+",\"turnId\":\"turn-fixture\",\"itemId\":\"message-fixture\",\"delta\":"+json_quote(c.get("text").as_string())+"}");
 x.notify("turn/completed","{\"threadId\":"+json_quote(sid())+",\"turn\":"+t+"}");
}
bind("initialize","init");bind("initialized","noop");bind("thread/start","open");bind("thread/resume","open");bind("turn/start","turn");

end _lmcode_
savedsl(p, ARGV[0]);
